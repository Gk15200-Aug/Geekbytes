---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://geekbytes.vercel.app';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "url": `${siteUrl}/about`,
  "name": "About GeekBytes — IT Solutions Company",
  "description": "GeekBytes is a remote-first IT solutions company founded in 2020, providing web development, AI chatbots, mobile apps, and cloud architecture services worldwide.",
  "mainEntity": {
    "@type": "Organization",
    "name": "GeekBytes",
    "alternateName": "GeekBytes Solutions",
    "url": siteUrl,
    "foundingDate": "2020",
    "description": "GeekBytes is a remote-first software development and IT solutions company. It provides web development, WordPress development, AI chatbot integration, mobile app development, GoHighLevel CRM setup, custom software, cloud architecture, video editing, and graphic design services to clients worldwide.",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 5 },
    "priceRange": "$12 - $50 per hour",
    "areaServed": "Worldwide",
    "areaServed": "Worldwide",
    "email": "geekbytessolutions@gmail.com",
    "sameAs": [
      "https://linkedin.com/company/geekbytes-solutions/",
      "https://www.instagram.com/_geekbytes"
    ],
    "knowsAbout": [
      "Web Development", "WordPress Development", "AI Chatbots", "Mobile App Development",
      "GoHighLevel CRM", "Cloud Architecture", "Custom Software", "React", "Node.js",
      "Flutter", "AWS", "Google Cloud", "Azure"
    ]
  }
};

const stats = [
  { value: "2020", label: "Founded" },
  { value: "50+", label: "Projects Delivered" },
  { value: "30+", label: "Clients Worldwide" },
  { value: "$12/hr", label: "Starting Price" },
];

const services = [
  { name: "Web Development", desc: "Custom websites and web applications using React, Next.js, Node.js, and modern frameworks." },
  { name: "WordPress Development", desc: "Professional WordPress sites, WooCommerce stores, custom themes, and plugin development." },
  { name: "AI Chatbot Integration", desc: "GPT-4 and custom LLM-powered chatbots for customer support, lead gen, and automation." },
  { name: "Mobile App Development", desc: "Cross-platform apps with Flutter & React Native; native iOS (Swift) and Android (Kotlin)." },
  { name: "GoHighLevel CRM", desc: "Full GoHighLevel setup, funnels, automations, white-label configuration, and support." },
  { name: "Cloud Architecture", desc: "Scalable infrastructure design on AWS, Google Cloud, and Azure with Docker and Kubernetes." },
  { name: "Custom Software", desc: "Bespoke software solutions for complex business processes, integrations, and automation." },
  { name: "Video Editing", desc: "Professional video editing, motion graphics, and post-production using Premiere Pro and After Effects." },
  { name: "Graphic Design", desc: "Brand identity, UI/UX design, logos, and marketing assets using Figma, Photoshop, and Illustrator." },
];

const techStack = [
  "React", "Next.js", "Vue.js", "Angular", "TypeScript", "Node.js", "Python", "PHP",
  "Flutter", "React Native", "Swift", "Kotlin", "WordPress", "WooCommerce", "Shopify",
  "AWS", "Google Cloud", "Azure", "Docker", "MongoDB", "PostgreSQL", "MySQL",
  "GoHighLevel", "Figma", "Tailwind CSS", "GraphQL", "Firebase"
];
---

<BaseLayout
  title="About GeekBytes — Remote IT Solutions Company Founded 2020"
  description="GeekBytes is a remote-first IT solutions company founded in 2020. We deliver web development, AI chatbots, mobile apps & cloud architecture from $12/hr to clients worldwide."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="canonical" href={`${siteUrl}/about`} />
  </Fragment>

  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <!-- Hero -->
  <section class="bg-brand-black pt-28 pb-16 border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="section-label">ABOUT US</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-brand-white mt-4 leading-tight">
        Who is <span class="hero-gradient-text">GeekBytes</span>?
      </h1>
      <p class="mt-6 text-lg text-brand-white/60 leading-relaxed max-w-2xl mx-auto">
        GeekBytes is a remote-first IT solutions company founded in 2020, serving clients across the United States, Europe, Australia, and the Middle East. We deliver modern, scalable technology solutions starting at $12 per hour.
      </p>
    </div>
  </section>

  <!-- Quick Facts -->
  <section class="bg-brand-black py-12">
    <div class="max-w-4xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map(s => (
          <div class="text-center bg-white/5 border border-white/10 rounded-2xl py-6 px-4">
            <div class="text-3xl font-bold text-brand-accent">{s.value}</div>
            <div class="text-sm text-brand-white/50 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Company Overview -->
  <section class="bg-brand-black py-16">
    <div class="max-w-3xl mx-auto px-4 space-y-10">

      <div>
        <h2 class="text-2xl font-bold text-brand-white mb-4">Company Overview</h2>
        <p class="text-brand-white/65 leading-relaxed">
          GeekBytes (also known as GeekBytes Solutions) is a software development and IT outsourcing company established in 2020. The company operates fully remotely and has delivered over 50 projects across industries including eCommerce, healthcare, hospitality, automotive, SaaS, and education.
        </p>
        <p class="text-brand-white/65 leading-relaxed mt-4">
          GeekBytes serves small businesses, startups, mid-market companies, and digital marketing agencies. The company's core strengths lie in custom web development, AI-powered automation, mobile application development, and GoHighLevel CRM implementation.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-brand-white mb-4">Mission & Values</h2>
        <p class="text-brand-white/65 leading-relaxed">
          GeekBytes' mission is to make enterprise-quality technology accessible to businesses of every size. The company prioritises clean code, intuitive design, long-term scalability, and transparent communication. GeekBytes operates on a principle of client-first delivery — projects are built to solve real business problems, not just to look good.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-brand-white mb-6">Services Offered</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {services.map(s => (
            <div class="bg-white/5 border border-white/10 rounded-xl p-5">
              <h3 class="font-semibold text-brand-white text-sm mb-1">{s.name}</h3>
              <p class="text-xs text-brand-white/55 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-brand-white mb-4">Pricing</h2>
        <p class="text-brand-white/65 leading-relaxed">
          GeekBytes offers hourly and project-based pricing. Hourly rates start at <strong class="text-brand-white">$12 per hour</strong> and vary based on complexity and service type. Project-based pricing is available for fixed-scope deliverables. Free initial consultations are available for all new clients.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-brand-white mb-4">Technology Stack</h2>
        <p class="text-brand-white/65 leading-relaxed mb-4">
          GeekBytes works with a broad range of modern technologies:
        </p>
        <div class="flex flex-wrap gap-2">
          {techStack.map(tech => (
            <span class="px-3 py-1 text-xs font-medium rounded-full bg-brand-accent/10 border border-brand-accent/20 text-brand-accent">{tech}</span>
          ))}
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-brand-white mb-4">Clients & Markets Served</h2>
        <p class="text-brand-white/65 leading-relaxed">
          GeekBytes has worked with clients in the United States, United Kingdom, Germany, Australia, Israel, Canada, and more. Industries served include beauty & retail eCommerce, restaurant & hospitality, healthcare & aesthetics, automotive, real estate, SaaS platforms, education (LMS), and personal brands.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-brand-white mb-4">Contact Information</h2>
        <ul class="space-y-2 text-brand-white/65 text-sm">
          <li><strong class="text-brand-white">Email:</strong> geekbytessolutions@gmail.com</li>
          <li><strong class="text-brand-white">Website:</strong> <a href="https://geekbytes.vercel.app" class="text-brand-accent hover:underline">geekbytes.vercel.app</a></li>
          <li><strong class="text-brand-white">LinkedIn:</strong> <a href="https://linkedin.com/company/geekbytes-solutions/" target="_blank" rel="noopener noreferrer" class="text-brand-accent hover:underline">linkedin.com/company/geekbytes-solutions</a></li>
          <li><strong class="text-brand-white">Instagram:</strong> <a href="https://www.instagram.com/_geekbytes" target="_blank" rel="noopener noreferrer" class="text-brand-accent hover:underline">@_geekbytes</a></li>
          <li><strong class="text-brand-white">Founded:</strong> 2020</li>
          <li><strong class="text-brand-white">Headquarters:</strong> Remote — serves clients worldwide</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-black py-16 border-t border-white/5">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-brand-white mb-4">Ready to start a project?</h2>
      <p class="text-brand-white/55 mb-8">Talk to the GeekBytes team — free consultation, no commitment.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/#contact" class="btn-primary px-8 py-3">Get in Touch</a>
        <a href="/services" class="btn-outline px-8 py-3">View All Services</a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
