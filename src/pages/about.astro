---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://www.geekbytestech.com';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "url": `${siteUrl}/about`,
  "name": "About GeekBytes — IT Solutions Company",
  "description": "GeekBytes is a remote-first IT solutions company founded in 2020, providing web development, AI chatbots, mobile apps, and cloud architecture services worldwide.",
  "mainEntity": {
    "@type": "Organization",
    "name": "GeekBytes",
    "alternateName": "GeekBytes Solutions",
    "url": siteUrl,
    "foundingDate": "2020",
    "description": "GeekBytes is a remote-first software development and IT solutions company. It provides web development, WordPress development, AI chatbot integration, mobile app development, GoHighLevel CRM setup, custom software, cloud architecture, video editing, and graphic design services to clients worldwide.",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 5 },
    "priceRange": "$12 - $50 per hour",
    "areaServed": "Worldwide",
    "areaServed": "Worldwide",
    "email": "info@geekbytestech.com",
    "sameAs": [
      "https://linkedin.com/company/geekbytes-solutions/",
      "https://www.instagram.com/_geekbytes"
    ],
    "knowsAbout": [
      "Web Development", "WordPress Development", "AI Chatbots", "Mobile App Development",
      "GoHighLevel CRM", "Cloud Architecture", "Custom Software", "React", "Node.js",
      "Flutter", "AWS", "Google Cloud", "Azure"
    ]
  }
};

const stats = [
  { value: "2020", label: "Founded" },
  { value: "50+", label: "Projects Delivered" },
  { value: "30+", label: "Clients Worldwide" },
  { value: "$12/hr", label: "Starting Price" },
];

const timeline = [
  { year: "2020", event: "Founded GeekBytes while working in enterprise IT. First 5 clients in 3 months." },
  { year: "2021", event: "Launched Auto Reply Bot — reached 50,000+ downloads on Google Play." },
  { year: "2022", event: "Delivered first international projects: US, UK & Australia. Team grows to 5." },
  { year: "2023", event: "Auto Reply Bot surpasses 1,000,000+ installs. Expanded into AI chatbot services." },
  { year: "2024", event: "50+ projects delivered. Added GoHighLevel, Cloud Architecture & Custom SaaS to offerings." },
  { year: "2025", event: "Launched geekbytestech.com. Serving clients in 10+ countries across 7 industries." },
];

const clients = [
  { name: "The Palm", logo: "/images/projects/the-palm.webp" },
  { name: "TEDxNuremberg", logo: "/images/projects/tedxnuremberg.webp" },
  { name: "Hardens", logo: "/images/projects/hardens.webp" },
  { name: "VaporFi", logo: "/images/projects/vaporfi.webp" },
  { name: "One Aesthetics", logo: "/images/projects/one-aesthetics.webp" },
  { name: "CollabDiary", logo: "/images/projects/collabdiary.webp" },
];

const techStack = [
  "React", "Next.js", "Vue.js", "Angular", "TypeScript", "Node.js", "Python", "PHP",
  "Flutter", "React Native", "Swift", "Kotlin", "WordPress", "WooCommerce", "Shopify",
  "AWS", "Google Cloud", "Azure", "Docker", "MongoDB", "PostgreSQL", "MySQL",
  "GoHighLevel", "Figma", "Tailwind CSS", "GraphQL", "Firebase"
];
---

<BaseLayout
  title="About GeekBytes — Remote IT Solutions Company Founded 2020"
  description="GeekBytes is a remote-first IT solutions company founded in 2020. We deliver web development, AI chatbots, mobile apps & cloud architecture from $12/hr to clients worldwide."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="canonical" href={`${siteUrl}/about`} />
  </Fragment>

  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <!-- Hero -->
  <section class="bg-brand-black pt-28 pb-16 border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="section-label">ABOUT US</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-brand-white mt-4 leading-tight">
        Who is <span class="hero-gradient-text">GeekBytes</span>?
      </h1>
      <p class="mt-6 text-lg text-brand-white/60 leading-relaxed max-w-2xl mx-auto">
        GeekBytes is a remote-first IT solutions company founded in 2020, serving clients across the United States, Europe, Australia, and the Middle East. We deliver modern, scalable technology solutions starting at $12 per hour.
      </p>
    </div>
  </section>

  <!-- Quick Facts -->
  <section class="bg-brand-black py-12">
    <div class="max-w-4xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map(s => (
          <div class="text-center bg-white/5 border border-white/10 rounded-2xl py-6 px-4">
            <div class="text-3xl font-bold text-brand-accent">{s.value}</div>
            <div class="text-sm text-brand-white/50 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder Section -->
  <section class="bg-brand-black py-16 border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex flex-col md:flex-row gap-10 items-start">
        <!-- Avatar placeholder — replace src with actual photo -->
        <div class="shrink-0">
          <div class="w-36 h-36 rounded-2xl bg-gradient-to-br from-brand-accent/20 to-blue-500/10 border border-brand-accent/30 flex items-center justify-center text-brand-accent overflow-hidden">
            <svg class="w-20 h-20 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <p class="text-xs text-gray-500 text-center mt-2">Ethan Walker</p>
        </div>

        <div>
          <p class="text-xs text-brand-accent font-bold uppercase tracking-widest mb-3">Meet the Founder</p>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-white mb-4">Ethan Walker · Founder & Lead Engineer</h2>
          <p class="text-brand-white/65 leading-relaxed mb-4">
            Before starting GeekBytes, I spent years in enterprise software at companies including <strong class="text-brand-white">IBM</strong> and <strong class="text-brand-white">Oracle</strong>, working on large-scale systems that millions of people rely on daily. In 2020, I founded GeekBytes with a simple idea: small and mid-size businesses deserve the same quality of engineering that Fortune 500 companies get — without the Fortune 500 price tag.
          </p>
          <p class="text-brand-white/65 leading-relaxed mb-6">
            Outside client work, I build consumer apps. My Android apps have been downloaded by over <strong class="text-brand-white">1.5 million users</strong> on Google Play. That background — shipping real products to real users — is what separates GeekBytes from an agency that just runs through templates.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://linkedin.com/company/geekbytes-solutions/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/15 text-brand-white/60 hover:border-brand-accent/40 hover:text-brand-white transition-colors text-sm font-medium"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a
              href="https://calendly.com/geekbytessolutions"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-accent/10 border border-brand-accent/30 text-brand-accent hover:bg-brand-accent/20 transition-colors text-sm font-semibold"
            >
              Book a direct call with Ethan →
            </a>
          </div>

          <!-- Credential chips -->
          <div class="flex flex-wrap gap-2 mt-5">
            {["Ex-IBM", "Ex-Oracle", "1.5M+ Play Store Downloads", "50+ Projects Delivered", "10+ Countries"].map(chip => (
              <span class="text-xs px-3 py-1 rounded-full border border-white/10 text-brand-white/50 bg-white/[0.03]">{chip}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="bg-brand-black py-16 border-b border-white/5">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-brand-white mb-6">Why GeekBytes Exists</h2>
      <p class="text-brand-white/65 leading-relaxed mb-4">
        Most small businesses face the same problem: they can't afford a $150/hr US agency, and the $5/hr freelancer platforms are a gamble. The middle ground — senior-level engineers who communicate clearly, deliver on time, and actually understand business outcomes — barely existed at an accessible price.
      </p>
      <p class="text-brand-white/65 leading-relaxed">
        GeekBytes was built to fill that gap. We operate remotely, keep our overhead low, and pass the savings directly to our clients. We don't use templates or junior developers on client projects. Every project is built by experienced engineers who have shipped production software at enterprise scale. That's the promise — and the reason 30+ clients have come back to us for more work.
      </p>
    </div>
  </section>

  <!-- Company Timeline -->
  <section class="bg-brand-black py-16 border-b border-white/5">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-brand-white mb-10">GeekBytes Timeline</h2>
      <div class="relative pl-6 border-l border-white/10 space-y-8">
        {timeline.map(({ year, event }) => (
          <div class="relative">
            <div class="absolute -left-[1.65rem] top-1 w-3 h-3 rounded-full bg-brand-accent border-2 border-brand-black"></div>
            <p class="text-brand-accent text-xs font-bold uppercase tracking-widest mb-1">{year}</p>
            <p class="text-brand-white/65 text-sm leading-relaxed">{event}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clients we've worked with -->
  <section class="bg-brand-black py-14 border-b border-white/5">
    <div class="max-w-4xl mx-auto px-4">
      <p class="text-xs text-gray-500 uppercase tracking-widest text-center mb-8">Clients We've Worked With</p>
      <div class="grid grid-cols-3 md:grid-cols-6 gap-6 items-center">
        {clients.map(client => (
          <div class="flex items-center justify-center p-3 rounded-xl bg-white/[0.03] border border-white/8 hover:border-white/15 transition-colors aspect-[3/2]">
            <img
              src={client.logo}
              alt={client.name}
              loading="lazy"
              class="w-full h-full object-cover rounded-lg opacity-50 grayscale hover:opacity-70 hover:grayscale-0 transition-all duration-300"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="bg-brand-black py-14 border-b border-white/5">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-brand-white mb-4">Technology Stack</h2>
      <p class="text-brand-white/65 leading-relaxed mb-5">
        We choose the right tool for each project — not a single "preferred stack."
      </p>
      <div class="flex flex-wrap gap-2">
        {techStack.map(tech => (
          <span class="px-3 py-1 text-xs font-medium rounded-full bg-brand-accent/10 border border-brand-accent/20 text-brand-accent">{tech}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-black py-16 border-t border-white/5">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-brand-white mb-4">Want to work with us?</h2>
      <p class="text-brand-white/55 mb-8">Book a free 15-min call with Ethan directly. No sales pitch — just a conversation about your project.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://calendly.com/geekbytessolutions" target="_blank" rel="noopener noreferrer" class="btn-primary px-8 py-3 inline-flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Book a Free Call
        </a>
        <a href="/case-studies" class="btn-outline px-8 py-3">See Our Work</a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
