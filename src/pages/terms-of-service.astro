---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Terms of Service — GeekBytes" description="Terms and Conditions for GeekBytes Solutions. By using our services, you agree to these terms.">
  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <!-- Hero banner -->
  <section class="relative pt-32 pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-accent/5 to-transparent"></div>
    <div class="relative max-w-4xl mx-auto px-4 text-center">
      <span class="section-label">LEGAL</span>
      <h1 class="section-heading mt-4">Terms of Service</h1>
      <p class="text-brand-white/50 mt-4 max-w-2xl mx-auto">By using our website and purchasing our services, you agree to the following terms and conditions.</p>
      <p class="text-brand-white/30 text-sm mt-4">Last updated: June 2026</p>
    </div>
  </section>

  <section class="pb-20 lg:pb-24">
    <div class="max-w-3xl mx-auto px-4">
      <div class="space-y-8">
        <!-- Numbered sections -->
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">1</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Services</h2>
            <p class="text-brand-white/60 mb-3">GeekBytes provides the following IT services at a rate of <span class="text-brand-accent font-medium">$12/hour</span> for development work:</p>
            <ul class="space-y-2">
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> Web Development (eCommerce, Business & Portfolio sites, Landing Pages)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> WordPress Development (Custom themes, plugins, WooCommerce, LMS)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> AI Chatbots & Automation (GPT-4, WhatsApp Business API, Workflows)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> GoHighLevel CRM (Pipelines, Funnels, SMS/Email, White-Label)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> Mobile App Development (iOS, Android, React Native, Flutter)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> Custom Software Solutions (SaaS, ERP, Dashboards, APIs)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> Cloud Architecture (AWS, Azure, GCP, Microservices, CI/CD)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> Video Editing (Promotional videos, Reels, Motion Graphics)</li>
              <li class="flex items-center gap-2 text-brand-white/60 text-sm"><span class="text-brand-accent">•</span> Graphic Design & Branding (Logo, Brand Identity, UI/UX, Marketing)</li>
            </ul>
          </div>
        </div>

        <div class="border-t border-white/5"></div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">2</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Maintenance Plans</h2>
            <p class="text-brand-white/60 mb-4">Our maintenance plans include regular website updates, security checks, performance optimization, monitoring, and technical support based on the selected plan.</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="bg-white/5 rounded-xl border border-white/10 p-4 text-center">
                <p class="text-brand-accent text-xl font-bold">$99</p>
                <p class="text-brand-white/50 text-xs mt-1">Monthly Plan</p>
              </div>
              <div class="bg-white/5 rounded-xl border border-white/10 p-4 text-center">
                <p class="text-brand-accent text-xl font-bold">$249</p>
                <p class="text-brand-white/50 text-xs mt-1">3-Month Plan</p>
              </div>
              <div class="bg-white/5 rounded-xl border border-white/10 p-4 text-center">
                <p class="text-brand-accent text-xl font-bold">$799</p>
                <p class="text-brand-white/50 text-xs mt-1">Yearly Plan</p>
              </div>
            </div>
            <p class="text-brand-white/40 text-sm mt-4">Development services: <span class="text-brand-accent font-medium">$12/hour</span></p>
          </div>
        </div>

        <div class="border-t border-white/5"></div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">3</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Payment Terms</h2>
            <p class="text-brand-white/60">All payments must be completed before services are activated. Pricing may change at any time without prior notice.</p>
          </div>
        </div>

        <div class="border-t border-white/5"></div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">4</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Refund Policy</h2>
            <p class="text-brand-white/60 mb-3">We offer a 30-day money-back guarantee for maintenance services. Refunds may not apply for:</p>
            <ul class="space-y-2">
              <li class="flex items-start gap-2 text-brand-white/60 text-sm"><svg class="w-4 h-4 text-red-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg> Custom development work already completed</li>
              <li class="flex items-start gap-2 text-brand-white/60 text-sm"><svg class="w-4 h-4 text-red-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg> Third-party software or hosting issues</li>
              <li class="flex items-start gap-2 text-brand-white/60 text-sm"><svg class="w-4 h-4 text-red-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg> Services affected by incorrect client access</li>
              <li class="flex items-start gap-2 text-brand-white/60 text-sm"><svg class="w-4 h-4 text-red-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg> Policy violations or misuse of services</li>
            </ul>
          </div>
        </div>

        <div class="border-t border-white/5"></div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">5</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Client Responsibilities</h2>
            <p class="text-brand-white/60">Clients are responsible for providing correct website access, account information, and necessary permissions required to perform services.</p>
          </div>
        </div>

        <div class="border-t border-white/5"></div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">6</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Service Availability</h2>
            <p class="text-brand-white/60">We aim to provide reliable and uninterrupted services, but we do not guarantee that services will always be error-free or uninterrupted.</p>
          </div>
        </div>

        <div class="border-t border-white/5"></div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">7</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Limitation of Liability</h2>
            <p class="text-brand-white/60">We are not responsible for any indirect, incidental, or consequential damages resulting from the use of our services.</p>
          </div>
        </div>

        <div class="border-t border-white/5"></div>

        <div class="flex gap-4">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent text-sm font-bold">8</div>
          <div>
            <h2 class="text-xl font-bold text-brand-white mb-2">Termination</h2>
            <p class="text-brand-white/60">We reserve the right to suspend or terminate services if users violate these terms or misuse our services.</p>
          </div>
        </div>

        <!-- Note -->
        <div class="border border-brand-accent/20 rounded-2xl p-6 bg-brand-accent/5 mt-10">
          <p class="text-brand-white/70 text-sm"><strong class="text-brand-white">Note:</strong> We may update these terms at any time. For questions, contact us at <a href="mailto:geekbytessolutions@gmail.com" class="text-brand-accent hover:underline">geekbytessolutions@gmail.com</a></p>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
