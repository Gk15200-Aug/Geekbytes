---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const siteUrl = 'https://geekbytestech.com';
const postUrl = `${siteUrl}/blog/${post.slug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog` },
        { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postUrl },
      ],
    },
    {
      "@type": "BlogPosting",
      "@id": postUrl,
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.pubDate.toISOString(),
      "dateModified": post.data.pubDate.toISOString(),
      "author": {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": post.data.author,
      },
      "publisher": {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": "GeekBytes",
        "logo": { "@type": "ImageObject", "url": `${siteUrl}/images/og-image.png` },
      },
      "url": postUrl,
      "keywords": post.data.tags.join(', '),
      "timeRequired": `PT${post.data.readingTime}M`,
    },
  ],
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const tagColors = [
  "bg-blue-500/10 text-blue-400 border-blue-500/20",
  "bg-purple-500/10 text-purple-400 border-purple-500/20",
  "bg-green-500/10 text-green-400 border-green-500/20",
  "bg-orange-500/10 text-orange-400 border-orange-500/20",
  "bg-pink-500/10 text-pink-400 border-pink-500/20",
];

// Get related posts (other posts, up to 2)
const allPosts = await getCollection('blog');
const related = allPosts.filter(p => p.slug !== post.slug).slice(0, 2);
---

<BaseLayout title={`${post.data.title} — GeekBytes Blog`} description={post.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:author" content={post.data.author} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <!-- Reading progress bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-brand-accent to-blue-400 z-[60] transition-all duration-100" style="width: 0%"></div>

  <!-- Hero -->
  <section class="relative pt-32 pb-16 overflow-hidden bg-brand-black">
    <div class="absolute inset-0 hero-grid opacity-20"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-brand-accent/6 rounded-full blur-[140px]"></div>

    <div class="relative max-w-3xl mx-auto px-4">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-10">
        <ol class="flex items-center gap-2 text-xs text-brand-white/30 w-fit bg-white/5 px-4 py-2 rounded-full border border-white/10 flex-wrap">
          <li><a href="/" class="hover:text-brand-accent transition-colors">Home</a></li>
          <li><span aria-hidden="true" class="mx-1">/</span></li>
          <li><a href="/blog" class="hover:text-brand-accent transition-colors">Blog</a></li>
          <li><span aria-hidden="true" class="mx-1">/</span></li>
          <li class="text-brand-white/50 truncate max-w-[180px]" aria-current="page">{post.data.title}</li>
        </ol>
      </nav>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-7">
        {post.data.tags.map((tag, i) => (
          <span class={`text-xs px-3 py-1.5 rounded-full border font-medium ${tagColors[i % tagColors.length]}`}>
            {tag}
          </span>
        ))}
      </div>

      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-brand-white leading-[1.1] tracking-tight mb-6">
        {post.data.title}
      </h1>

      <p class="text-lg text-brand-white/55 leading-relaxed mb-8">{post.data.description}</p>

      <!-- Listen Panel -->
      <div class="mb-8 bg-white/[0.04] border border-white/10 rounded-2xl p-5 space-y-4">
        <!-- Row 1: Play button + sound wave -->
        <div class="flex items-center gap-4 flex-wrap">
          <button
            id="listen-btn"
            class="group flex items-center gap-3 px-5 py-2.5 rounded-full bg-brand-accent/10 border border-brand-accent/30 text-brand-accent hover:bg-brand-accent hover:text-brand-black transition-all duration-300 font-semibold text-sm shrink-0"
            aria-label="Listen to this article"
          >
            <span class="flex items-center justify-center w-6 h-6 rounded-full bg-brand-accent/20 group-hover:bg-brand-black/20 transition-colors">
              <svg id="icon-play" class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg id="icon-pause" class="w-3 h-3 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              <svg id="icon-stop" class="w-3 h-3 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h12v12H6z"/></svg>
            </span>
            <span id="listen-label">Listen to this article</span>
            <span id="sound-wave" class="hidden items-center gap-0.5 h-3.5">
              <span class="w-0.5 h-1.5 bg-current rounded-full animate-bounce" style="animation-delay:0ms"></span>
              <span class="w-0.5 h-3.5 bg-current rounded-full animate-bounce" style="animation-delay:150ms"></span>
              <span class="w-0.5 h-2.5 bg-current rounded-full animate-bounce" style="animation-delay:75ms"></span>
              <span class="w-0.5 h-3.5 bg-current rounded-full animate-bounce" style="animation-delay:225ms"></span>
              <span class="w-0.5 h-1.5 bg-current rounded-full animate-bounce" style="animation-delay:100ms"></span>
            </span>
          </button>

          <!-- Voice name display -->
          <span id="voice-name-display" class="text-xs text-brand-white/30 italic truncate max-w-[180px]"></span>
        </div>

        <!-- Row 2: Voice gender selector -->
        <div class="flex items-center gap-3 flex-wrap">
          <span class="text-xs text-brand-white/40 shrink-0">Voice:</span>
          <div class="flex gap-2">
            <button id="voice-female" class="voice-gender-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/10 text-xs text-brand-white/50 hover:border-brand-accent/40 hover:text-brand-accent transition-all" data-gender="female">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a5 5 0 100 10A5 5 0 0012 2zm0 12c-5.33 0-8 2.67-8 4v2h16v-2c0-1.33-2.67-4-8-4z"/></svg>
              Female
            </button>
            <button id="voice-male" class="voice-gender-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/10 text-xs text-brand-white/50 hover:border-brand-accent/40 hover:text-brand-accent transition-all" data-gender="male">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a5 5 0 100 10A5 5 0 0012 2zm0 12c-5.33 0-8 2.67-8 4v2h16v-2c0-1.33-2.67-4-8-4z"/></svg>
              Male
            </button>
            <button id="voice-custom" class="voice-gender-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/10 text-xs text-brand-white/50 hover:border-brand-accent/40 hover:text-brand-accent transition-all" data-gender="custom">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
              Custom
            </button>
          </div>
          <!-- Custom voice dropdown -->
          <select id="voice-select" class="hidden text-xs rounded-lg px-3 py-1.5 focus:outline-none cursor-pointer" style="background:#111; border:1px solid rgba(255,255,255,0.15); color:rgba(255,255,255,0.7);">
            <option value="" style="background:#111;">Loading voices...</option>
          </select>
        </div>

        <!-- Row 3: Speed (hidden until playing) -->
        <div id="speed-control" class="hidden flex items-center gap-3 flex-wrap">
          <span class="text-xs text-brand-white/40 shrink-0">Speed:</span>
          {[0.75, 1, 1.25, 1.5, 2].map((s) => (
            <button class="speed-btn px-2.5 py-1 rounded-full border border-white/10 text-xs text-brand-white/40 hover:border-brand-accent/40 hover:text-brand-accent transition-all" data-speed={String(s)}>
              {s}×
            </button>
          ))}
        </div>
      </div>

      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-5 pb-8 border-b border-white/8">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span class="text-sm text-brand-white/60 font-medium">{post.data.author}</span>
        </div>

        <div class="flex items-center gap-2 text-sm text-brand-white/40">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </div>

        <div class="flex items-center gap-2 text-sm text-brand-white/40">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{post.data.readingTime} min read</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TL;DR Summary box — AI tools (Perplexity, ChatGPT, Gemini) cite this as the quick answer -->
  <section class="pt-8 pb-0">
    <div class="max-w-3xl mx-auto px-4">
      <div class="rounded-2xl border border-brand-accent/25 bg-brand-accent/5 px-6 py-5">
        <p class="text-xs font-bold text-brand-accent uppercase tracking-widest mb-2">Quick Summary</p>
        <p class="text-sm text-brand-white/75 leading-relaxed">{post.data.description}</p>
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <section class="py-12">
    <div class="max-w-3xl mx-auto px-4">
      <div id="article-content" class="
        prose prose-invert prose-lg max-w-none

        [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:text-white [&_h2]:mt-14 [&_h2]:mb-5
        [&_h2]:pb-4 [&_h2]:border-b [&_h2]:border-white/10 [&_h2]:tracking-tight

        [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-white/90 [&_h3]:mt-10 [&_h3]:mb-4

        [&_p]:text-white/65 [&_p]:leading-[1.85] [&_p]:text-base [&_p]:mb-6

        [&_a]:text-[#00A3FF] [&_a]:font-medium [&_a]:no-underline hover:[&_a]:underline

        [&_strong]:text-white [&_strong]:font-bold

        [&_ul]:my-6 [&_ul]:space-y-2 [&_ul]:pl-0 [&_ul]:list-none
        [&_ul_li]:relative [&_ul_li]:pl-6 [&_ul_li]:text-white/65 [&_ul_li]:leading-relaxed [&_ul_li]:text-base
        [&_ul_li]:before:content-[''] [&_ul_li]:before:absolute [&_ul_li]:before:left-0 [&_ul_li]:before:top-2.5
        [&_ul_li]:before:w-1.5 [&_ul_li]:before:h-1.5 [&_ul_li]:before:rounded-full [&_ul_li]:before:bg-[#00A3FF]

        [&_ol]:my-6 [&_ol]:space-y-3 [&_ol]:pl-0 [&_ol]:list-none [&_ol]:counter-reset-[item]
        [&_ol_li]:relative [&_ol_li]:pl-10 [&_ol_li]:text-white/65 [&_ol_li]:leading-relaxed [&_ol_li]:text-base
        [&_ol_li]:before:content-[counter(item)] [&_ol_li]:before:counter-increment-[item]
        [&_ol_li]:before:absolute [&_ol_li]:before:left-0 [&_ol_li]:before:top-0.5
        [&_ol_li]:before:w-6 [&_ol_li]:before:h-6 [&_ol_li]:before:rounded-full
        [&_ol_li]:before:bg-[#00A3FF]/10 [&_ol_li]:before:text-[#00A3FF] [&_ol_li]:before:text-xs
        [&_ol_li]:before:font-bold [&_ol_li]:before:flex [&_ol_li]:before:items-center [&_ol_li]:before:justify-center

        [&_blockquote]:border-l-4 [&_blockquote]:border-[#00A3FF] [&_blockquote]:bg-[#00A3FF]/5
        [&_blockquote]:rounded-r-2xl [&_blockquote]:px-6 [&_blockquote]:py-5 [&_blockquote]:my-8
        [&_blockquote]:not-italic [&_blockquote]:text-white/70 [&_blockquote]:leading-relaxed

        [&_code]:text-[#00A3FF] [&_code]:bg-[#00A3FF]/10 [&_code]:px-2 [&_code]:py-0.5
        [&_code]:rounded [&_code]:text-sm [&_code]:font-mono [&_code]:border [&_code]:border-[#00A3FF]/20

        [&_pre]:bg-white/5 [&_pre]:border [&_pre]:border-white/10 [&_pre]:rounded-2xl
        [&_pre]:p-6 [&_pre]:my-8 [&_pre]:overflow-x-auto [&_pre]:shadow-xl
        [&_pre_code]:bg-transparent [&_pre_code]:border-0 [&_pre_code]:p-0 [&_pre_code]:text-white/80

        [&_hr]:border-white/10 [&_hr]:my-12

        [&_table]:w-full [&_table]:my-8 [&_table]:border-collapse
        [&_thead]:border-b-2 [&_thead]:border-white/10
        [&_th]:text-white [&_th]:font-bold [&_th]:text-sm [&_th]:py-3 [&_th]:px-4
        [&_th]:text-left [&_th]:bg-white/5
        [&_td]:text-white/60 [&_td]:py-3 [&_td]:px-4 [&_td]:border-b [&_td]:border-white/5 [&_td]:text-sm
        [&_tr:hover_td]:bg-white/[0.02]
      ">
        <Content />
      </div>
    </div>
  </section>

  <!-- Author CTA -->
  <section class="py-12 border-t border-white/8">
    <div class="max-w-3xl mx-auto px-4">
      <div class="relative bg-gradient-to-br from-brand-accent/10 via-white/[0.03] to-blue-500/5 border border-brand-accent/20 rounded-3xl p-8 md:p-10 overflow-hidden">
        <div class="absolute inset-0 hero-grid opacity-5"></div>
        <div class="relative flex flex-col md:flex-row items-start gap-6">
          <div class="w-16 h-16 rounded-2xl bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center text-brand-accent shrink-0">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-xs text-brand-accent/70 uppercase tracking-wider font-semibold mb-1">Written by</p>
            <h3 class="text-lg font-bold text-brand-white mb-2">{post.data.author}</h3>
            <p class="text-sm text-brand-white/55 leading-relaxed mb-6">
              The GeekBytes team builds custom web applications, AI chatbots, mobile apps, and cloud infrastructure for businesses worldwide. We write from direct project experience, not theory.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="/#contact" class="btn-primary text-sm px-7 py-3 inline-flex items-center justify-center gap-2">
                Work With Us &rarr;
              </a>
              <a href="/services" class="px-7 py-3 rounded-full border border-white/15 text-brand-white/60 hover:border-brand-accent/40 hover:text-brand-white transition-all text-sm font-medium inline-flex items-center justify-center gap-2">
                View Services
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Posts -->
  {related.length > 0 && (
    <section class="py-16 border-t border-white/5">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-xl font-bold text-brand-white mb-8">More from the blog</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {related.map((p) => (
            <a href={`/blog/${p.slug}`} class="group bg-white/[0.03] border border-white/8 rounded-2xl p-6 hover:border-brand-accent/30 hover:bg-white/[0.05] transition-all duration-300">
              <div class="flex flex-wrap gap-2 mb-3">
                {p.data.tags.slice(0, 1).map((tag) => (
                  <span class="text-xs px-2.5 py-1 rounded-full bg-brand-accent/10 text-brand-accent border border-brand-accent/20 font-medium">
                    {tag}
                  </span>
                ))}
              </div>
              <h3 class="text-sm font-bold text-brand-white group-hover:text-brand-accent transition-colors leading-snug mb-2">
                {p.data.title}
              </h3>
              <p class="text-xs text-brand-white/35 flex items-center gap-2">
                <span>{formatDate(p.data.pubDate)}</span>
                <span>·</span>
                <span>{p.data.readingTime} min</span>
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Navigation bar -->
  <section class="py-8 border-t border-white/5">
    <div class="max-w-3xl mx-auto px-4 flex justify-between items-center">
      <a href="/blog" class="flex items-center gap-2 text-sm font-medium text-brand-white/50 hover:text-brand-accent transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        All Posts
      </a>
      <a href="/services" class="flex items-center gap-2 text-sm font-medium text-brand-white/50 hover:text-brand-accent transition-colors">
        Our Services
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>

<script>
  // ── Reading progress bar ──────────────────────────────────────────
  const bar = document.getElementById('reading-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      bar.style.width = scrollHeight > 0 ? `${(scrollTop / scrollHeight) * 100}%` : '0%';
    }, { passive: true });
  }

  if (!('speechSynthesis' in window)) {
    const btn = document.getElementById('listen-btn');
    if (btn) { btn.textContent = 'TTS not supported in this browser'; (btn as HTMLButtonElement).disabled = true; }
  } else {
    // ── Voice management ───────────────────────────────────────────
    const listenBtn       = document.getElementById('listen-btn') as HTMLButtonElement;
    const listenLabel     = document.getElementById('listen-label')!;
    const iconPlay        = document.getElementById('icon-play')!;
    const iconPause       = document.getElementById('icon-pause')!;
    const iconStop        = document.getElementById('icon-stop')!;
    const soundWave       = document.getElementById('sound-wave')!;
    const speedControl    = document.getElementById('speed-control')!;
    const speedBtns       = document.querySelectorAll<HTMLButtonElement>('.speed-btn');
    const genderBtns      = document.querySelectorAll<HTMLButtonElement>('.voice-gender-btn');
    const voiceSelect     = document.getElementById('voice-select') as HTMLSelectElement;
    const voiceNameDisplay = document.getElementById('voice-name-display')!;

    let chunks: string[] = [];
    let chunkIndex = 0;
    let currentSpeed = 1;
    let isPlaying = false;
    let isPaused = false;
    let keepAliveTimer: ReturnType<typeof setInterval> | null = null;
    let selectedVoice: SpeechSynthesisVoice | null = null;
    let selectedGender: 'female' | 'male' | 'custom' = 'female';
    let allVoices: SpeechSynthesisVoice[] = [];

    // Classify voices by gender heuristic (name-based)
    function classifyVoice(v: SpeechSynthesisVoice): 'female' | 'male' | 'unknown' {
      const n = v.name.toLowerCase();
      if (/\b(female|woman|girl|zira|samantha|victoria|karen|moira|fiona|tessa|veena|allison|ava|susan|lisa|emily|sarah|rachel|jessica|olivia|aria)\b/.test(n)) return 'female';
      if (/\b(male|man|guy|david|mark|daniel|alex|thomas|fred|jorge|luca|rishi|aaron|arthur|james|ryan)\b/.test(n)) return 'male';
      return 'unknown';
    }

    function loadVoices() {
      const allAvailable = speechSynthesis.getVoices();
      if (!allAvailable.length) return;
      const englishVoices = allAvailable.filter(v => v.lang.startsWith('en'));
      allVoices = englishVoices.length ? englishVoices : allAvailable;

      voiceSelect.innerHTML = '';
      const ph = document.createElement('option');
      ph.value = ''; ph.textContent = '\u2014 Pick a voice \u2014'; ph.style.background = '#111';
      voiceSelect.appendChild(ph);

      allVoices.forEach((v, i) => {
        const gender = classifyVoice(v);
        const genderLabel = gender === 'female' ? '\u2640' : gender === 'male' ? '\u2642' : '\u25cf';
        const opt = document.createElement('option');
        opt.value = String(i); opt.style.background = '#111';
        opt.textContent = `${genderLabel} ${v.name.replace(/^(Microsoft|Google)\s*/i, '')} (${v.lang})`;
        voiceSelect.appendChild(opt);
      });

      applyGenderChoice(selectedGender);
    }

    // Voices load async — try immediately, on event, and with retries
    loadVoices();
    speechSynthesis.addEventListener('voiceschanged', loadVoices);
    setTimeout(loadVoices, 300);
    setTimeout(loadVoices, 1200);

    function applyGenderChoice(gender: 'female' | 'male' | 'custom') {
      selectedGender = gender;
      if (gender === 'custom') {
        voiceSelect.classList.remove('hidden');
        // Pick whatever is selected in dropdown
        const idx = parseInt(voiceSelect.value);
        selectedVoice = !isNaN(idx) ? (allVoices[idx] || null) : null;
      } else {
        voiceSelect.classList.add('hidden');
        const matches = allVoices.filter(v => classifyVoice(v) === gender);
        // Prefer Google/premium voices
        const preferred = matches.find(v => v.name.toLowerCase().includes('google'))
          || matches.find(v => v.name.toLowerCase().includes('microsoft'))
          || matches[0]
          || allVoices[0]
          || null;
        selectedVoice = preferred;
      }

      voiceNameDisplay.textContent = selectedVoice
        ? selectedVoice.name.replace(/^(Microsoft|Google)\s*/i, '')
        : '';

      // Highlight active gender button
      genderBtns.forEach(b => {
        const active = b.dataset.gender === gender;
        b.classList.toggle('!border-[#00A3FF]', active);
        b.classList.toggle('!text-[#00A3FF]', active);
        b.classList.toggle('border-white/10', !active);
        b.classList.toggle('text-brand-white/50', !active);
      });
    }


    // Gender buttons
    genderBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const g = btn.dataset.gender as 'female' | 'male' | 'custom';
        applyGenderChoice(g);
        if (isPlaying || isPaused) restart();
      });
    });

    // Custom voice dropdown
    voiceSelect.addEventListener('change', () => {
      const idx = parseInt(voiceSelect.value);
      selectedVoice = !isNaN(idx) ? (allVoices[idx] || null) : null;
      voiceNameDisplay.textContent = selectedVoice ? selectedVoice.name.replace(/^(Microsoft|Google)\s*/i, '') : '';
      if (isPlaying || isPaused) restart();
    });

    // ── Chunking & playback ────────────────────────────────────────
    function getChunks(): string[] {
      const el = document.getElementById('article-content');
      if (!el) return [];
      const clone = el.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('pre, code, script').forEach(n => n.remove());
      const text = clone.innerText.replace(/\n{2,}/g, ' ').replace(/\s+/g, ' ').trim();
      const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];
      const result: string[] = [];
      let current = '';
      for (const s of sentences) {
        if ((current + s).split(' ').length > 180) {
          if (current.trim()) result.push(current.trim());
          current = s;
        } else {
          current += ' ' + s;
        }
      }
      if (current.trim()) result.push(current.trim());
      return result;
    }

    function setUI(state: 'idle' | 'playing' | 'paused') {
      iconPlay.classList.toggle('hidden', state !== 'idle');
      iconPause.classList.toggle('hidden', state !== 'playing');
      iconStop.classList.toggle('hidden', state !== 'paused');
      soundWave.classList.toggle('hidden', state !== 'playing');
      soundWave.classList.toggle('flex', state === 'playing');
      speedControl.classList.toggle('hidden', state === 'idle');
      if (state === 'idle')    listenLabel.textContent = 'Listen to this article';
      if (state === 'playing') listenLabel.textContent = 'Pause';
      if (state === 'paused')  listenLabel.textContent = 'Resume';
    }

    function startKeepAlive() {
      keepAliveTimer = setInterval(() => { if (isPlaying) speechSynthesis.getVoices(); }, 10000);
    }
    function stopKeepAlive() {
      if (keepAliveTimer) { clearInterval(keepAliveTimer); keepAliveTimer = null; }
    }

    function speakChunk(index: number) {
      if (index >= chunks.length) {
        isPlaying = false; isPaused = false; chunkIndex = 0; stopKeepAlive(); setUI('idle'); return;
      }
      const u = new SpeechSynthesisUtterance(chunks[index]);
      u.rate = currentSpeed;
      u.lang = 'en-US';
      if (selectedVoice) u.voice = selectedVoice;
      u.onend = () => { if (isPlaying) speakChunk(index + 1); };
      u.onerror = (e) => { if (e.error !== 'interrupted') { isPlaying = false; isPaused = false; stopKeepAlive(); setUI('idle'); } };
      speechSynthesis.speak(u);
      chunkIndex = index;
    }

    function startSpeech() {
      speechSynthesis.cancel();
      chunks = getChunks();
      if (!chunks.length) return;
      chunkIndex = 0; isPlaying = true; isPaused = false;
      startKeepAlive(); setUI('playing'); speakChunk(0);
    }

    function restart() {
      speechSynthesis.cancel();
      isPlaying = false; isPaused = false; stopKeepAlive();
      setTimeout(() => startSpeech(), 150);
    }

    listenBtn.addEventListener('click', () => {
      if (!isPlaying && !isPaused) {
        startSpeech();
      } else if (isPlaying) {
        speechSynthesis.pause(); isPaused = true; isPlaying = false; stopKeepAlive(); setUI('paused');
      } else if (isPaused) {
        speechSynthesis.resume(); isPaused = false; isPlaying = true; startKeepAlive(); setUI('playing');
      }
    });

    // Speed controls
    speedBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentSpeed = parseFloat(btn.dataset.speed || '1');
        speedBtns.forEach(b => { b.classList.remove('!border-[#00A3FF]', '!text-[#00A3FF]'); });
        btn.classList.add('!border-[#00A3FF]', '!text-[#00A3FF]');
        if (isPlaying || isPaused) restart();
      });
    });

    speedBtns.forEach(btn => {
      if (btn.dataset.speed === '1') btn.classList.add('!border-[#00A3FF]', '!text-[#00A3FF]');
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { speechSynthesis.cancel(); stopKeepAlive(); isPlaying = false; isPaused = false; setUI('idle'); }
    });
  }
</script>
