---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const siteUrl = 'https://www.geekbytestech.com';
const featured = posts[0];
const rest = posts.slice(1);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog` },
      ],
    },
    {
      "@type": "Blog",
      "@id": `${siteUrl}/blog`,
      "name": "GeekBytes Blog",
      "description": "Insights on web development, AI automation, mobile apps, cloud architecture, and digital growth strategies.",
      "url": `${siteUrl}/blog`,
      "publisher": { "@type": "Organization", "@id": `${siteUrl}/#organization`, "name": "GeekBytes" },
    },
  ],
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const tagColors = [
  "bg-blue-500/10 text-blue-400 border-blue-500/20",
  "bg-purple-500/10 text-purple-400 border-purple-500/20",
  "bg-green-500/10 text-green-400 border-green-500/20",
  "bg-orange-500/10 text-orange-400 border-orange-500/20",
  "bg-pink-500/10 text-pink-400 border-pink-500/20",
];
---

<BaseLayout
  title="Blog — GeekBytes"
  description="Insights on web development, AI chatbots, mobile apps, cloud architecture, and practical digital growth strategies for businesses in 2026."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <!-- Hero -->
  <section class="relative pt-32 pb-20 overflow-hidden bg-brand-black">
    <div class="absolute inset-0 hero-grid opacity-20"></div>
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-brand-accent/8 rounded-full blur-[140px]"></div>
    <div class="relative max-w-container mx-auto px-4 text-center">
      <nav aria-label="Breadcrumb" class="mb-10 flex justify-center">
        <ol class="flex items-center gap-2 text-xs text-brand-white/30 bg-white/5 px-4 py-2 rounded-full border border-white/10">
          <li><a href="/" class="hover:text-brand-accent transition-colors">Home</a></li>
          <li><span aria-hidden="true" class="mx-1">/</span></li>
          <li class="text-brand-white/60" aria-current="page">Blog</li>
        </ol>
      </nav>

      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-accent/10 border border-brand-accent/20 text-brand-accent text-xs font-semibold tracking-wider uppercase mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-accent animate-pulse"></span>
        Insights & Guides
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold text-brand-white leading-[1.05] tracking-tight mb-6">
        The GeekBytes<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-accent to-blue-400">Blog</span>
      </h1>
      <p class="text-lg md:text-xl text-brand-white/50 max-w-2xl mx-auto leading-relaxed">
        Practical guides on web development, AI automation, mobile apps, and cloud infrastructure. Written by practitioners, not theorists.
      </p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="py-16 border-t border-white/5">
      <div class="max-w-container mx-auto px-4">

        <!-- Featured post -->
        {featured && (
          <div class="mb-14">
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px flex-1 bg-white/10"></div>
              <span class="text-xs font-semibold text-brand-accent tracking-widest uppercase">Featured Post</span>
              <div class="h-px flex-1 bg-white/10"></div>
            </div>

            <a href={`/blog/${featured.slug}`} class="group block relative bg-white/[0.03] border border-white/8 rounded-3xl overflow-hidden hover:border-brand-accent/30 transition-all duration-500">
              <div class="absolute inset-0 bg-gradient-to-br from-brand-accent/0 group-hover:from-brand-accent/5 to-transparent transition-all duration-500"></div>
              <div class="relative p-10 md:p-14 flex flex-col md:flex-row gap-10 items-start">
                <!-- Left -->
                <div class="flex-1">
                  <div class="flex flex-wrap gap-2 mb-5">
                    {featured.data.tags.slice(0, 3).map((tag, i) => (
                      <span class={`text-xs px-3 py-1 rounded-full border font-medium ${tagColors[i % tagColors.length]}`}>
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-brand-white group-hover:text-brand-accent transition-colors duration-300 leading-tight mb-4">
                    {featured.data.title}
                  </h2>
                  <p class="text-brand-white/55 leading-relaxed mb-6 max-w-2xl text-base md:text-lg">
                    {featured.data.description}
                  </p>
                  <div class="flex items-center gap-6 text-xs text-brand-white/30">
                    <span>{formatDate(featured.data.pubDate)}</span>
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      {featured.data.readingTime} min read
                    </span>
                  </div>
                </div>

                <!-- Right CTA -->
                <div class="shrink-0 flex items-center">
                  <div class="w-14 h-14 rounded-full bg-brand-accent/10 border border-brand-accent/30 flex items-center justify-center group-hover:bg-brand-accent group-hover:border-brand-accent transition-all duration-300">
                    <svg class="w-5 h-5 text-brand-accent group-hover:text-brand-black transition-colors duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          </div>
        )}

        <!-- Rest of posts -->
        {rest.length > 0 && (
          <div>
            <div class="flex items-center gap-3 mb-8">
              <div class="h-px flex-1 bg-white/10"></div>
              <span class="text-xs font-semibold text-brand-white/30 tracking-widest uppercase">More Articles</span>
              <div class="h-px flex-1 bg-white/10"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {rest.map((post, idx) => (
                <article>
                  <a href={`/blog/${post.slug}`} class="group relative flex flex-col h-full bg-white/[0.03] border border-white/8 rounded-2xl p-7 hover:border-brand-accent/30 hover:bg-white/[0.05] transition-all duration-300 overflow-hidden">
                    <!-- Background number -->
                    <div class="absolute bottom-4 right-5 text-6xl font-black text-white/[0.03] group-hover:text-brand-accent/6 transition-colors select-none">
                      {String(idx + 2).padStart(2, '0')}
                    </div>

                    <div class="relative flex-1 flex flex-col">
                      <!-- Tags -->
                      <div class="flex flex-wrap gap-2 mb-4">
                        {post.data.tags.slice(0, 2).map((tag, i) => (
                          <span class={`text-xs px-2.5 py-1 rounded-full border font-medium ${tagColors[i % tagColors.length]}`}>
                            {tag}
                          </span>
                        ))}
                      </div>

                      <h2 class="text-lg font-bold text-brand-white mb-3 leading-snug group-hover:text-brand-accent transition-colors duration-300 flex-1">
                        {post.data.title}
                      </h2>

                      <p class="text-sm text-brand-white/45 leading-relaxed mb-6 line-clamp-2">
                        {post.data.description}
                      </p>

                      <div class="flex items-center justify-between text-xs text-brand-white/25 pt-4 border-t border-white/5">
                        <time datetime={post.data.pubDate.toISOString()}>
                          {formatDate(post.data.pubDate)}
                        </time>
                        <span class="flex items-center gap-1">
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                          {post.data.readingTime} min
                        </span>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Newsletter / CTA -->
  <section class="py-24 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4">
      <div class="relative rounded-3xl overflow-hidden border border-brand-accent/20 bg-gradient-to-br from-brand-accent/10 via-transparent to-blue-500/5 p-12 text-center">
        <div class="absolute inset-0 hero-grid opacity-10"></div>
        <div class="relative">
          <div class="w-16 h-16 rounded-2xl bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center text-brand-accent mx-auto mb-6">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-white mb-4">Need Help Implementing Any of This?</h2>
          <p class="text-brand-white/55 mb-8 max-w-lg mx-auto leading-relaxed">
            The GeekBytes team builds the things we write about. Web apps, AI chatbots, mobile apps, cloud infrastructure — all starting at <strong class="text-brand-white">$12/hour</strong>.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/#contact" class="btn-primary text-base px-10 py-4 inline-flex items-center justify-center gap-2">
              Get in Touch &rarr;
            </a>
            <a href="/services" class="px-10 py-4 rounded-full border border-white/20 text-brand-white/60 hover:border-brand-accent/40 hover:text-brand-white transition-all text-base font-medium inline-flex items-center justify-center gap-2">
              View All Services
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
