---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const siteUrl = 'https://geekbytes.vercel.app';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog` },
      ],
    },
    {
      "@type": "Blog",
      "@id": `${siteUrl}/blog`,
      "name": "GeekBytes Blog",
      "description": "Insights on web development, AI automation, mobile apps, cloud architecture, and digital growth strategies.",
      "url": `${siteUrl}/blog`,
      "publisher": {
        "@type": "Organization",
        "@id": `${siteUrl}/#organization`,
        "name": "GeekBytes",
      },
    },
  ],
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title="Blog — GeekBytes"
  description="Insights on web development, AI chatbots, mobile apps, cloud architecture, and practical digital growth strategies for businesses in 2026."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <!-- Hero -->
  <section class="relative pt-32 pb-20 overflow-hidden bg-brand-black">
    <div class="absolute inset-0 hero-grid opacity-30"></div>
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-accent/10 rounded-full blur-[120px]"></div>
    <div class="relative max-w-container mx-auto px-4 text-center">
      <nav aria-label="Breadcrumb" class="mb-8 flex justify-center">
        <ol class="flex items-center gap-2 text-sm text-brand-white/40">
          <li><a href="/" class="hover:text-brand-accent transition-colors">Home</a></li>
          <li><span aria-hidden="true">/</span></li>
          <li class="text-brand-white/70" aria-current="page">Blog</li>
        </ol>
      </nav>
      <span class="section-label">INSIGHTS & GUIDES</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-brand-white leading-tight mt-4 mb-6">
        The GeekBytes <span class="text-brand-accent">Blog</span>
      </h1>
      <p class="text-lg text-brand-white/60 max-w-2xl mx-auto leading-relaxed">
        Practical guides on web development, AI automation, mobile apps, cloud infrastructure, and growing your business with technology. Written by practitioners, not theorists.
      </p>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="py-20 border-t border-white/5">
    <div class="max-w-container mx-auto px-4">
      {posts.length === 0 ? (
        <p class="text-center text-brand-white/50">No posts yet — check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="group flex flex-col">
              <a href={`/blog/${post.slug}`} class="block flex-1">
                <div class="bg-white/5 border border-white/10 rounded-2xl p-8 h-full flex flex-col hover:border-brand-accent/40 hover:bg-brand-accent/5 transition-all duration-300">
                  <!-- Tags -->
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="text-xs px-3 py-1 rounded-full bg-brand-accent/10 text-brand-accent font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <!-- Title -->
                  <h2 class="text-xl font-bold text-brand-white mb-3 leading-tight group-hover:text-brand-accent transition-colors flex-1">
                    {post.data.title}
                  </h2>

                  <!-- Description -->
                  <p class="text-sm text-brand-white/50 leading-relaxed mb-6 line-clamp-3">
                    {post.data.description}
                  </p>

                  <!-- Meta -->
                  <div class="flex items-center justify-between text-xs text-brand-white/30 pt-4 border-t border-white/5">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                    <span>{post.data.readingTime} min read</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 border-t border-white/5">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-brand-white mb-4">Need Help Implementing Any of This?</h2>
      <p class="text-brand-white/60 mb-8">
        The GeekBytes team builds the things we write about. Web apps, AI chatbots, mobile apps, cloud infrastructure — all starting at $12/hour.
      </p>
      <a href="/#contact" class="btn-primary text-base px-10 py-4 inline-flex items-center gap-2">
        Get in Touch &rarr;
      </a>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
