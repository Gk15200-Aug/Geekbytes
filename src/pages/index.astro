---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FloatingChat from '../components/FloatingChat.astro';
import ChatBot from '../components/ChatBot.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';

const siteUrl = 'https://www.geekbytestech.com';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "GeekBytes",
      "alternateName": "GeekBytes Solutions",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/images/logo.jpeg`,
        "width": 200,
        "height": 200
      },
      "image": `${siteUrl}/images/og-image.png`,
      "description": siteConfig.meta.description,
      "email": siteConfig.email,
      "foundingDate": "2020",
      "numberOfEmployees": { "@type": "QuantitativeValue", "value": 5 },
      "sameAs": [
        "https://linkedin.com/company/geekbytes-solutions/",
        "https://www.instagram.com/_geekbytes"
      ],
      "areaServed": "Worldwide",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": siteConfig.email,
        "availableLanguage": ["English", "German", "Spanish"]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "GeekBytes",
      "description": "Modern IT Solutions & Software Development",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en"
    },
    {
      "@type": "WebPage",
      "@id": `${siteUrl}/#webpage`,
      "url": siteUrl,
      "name": siteConfig.meta.title,
      "description": siteConfig.meta.description,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "about": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en",
      "dateModified": new Date().toISOString().split('T')[0]
    },
    {
      "@type": "LocalBusiness",
      "@id": `${siteUrl}/#localbusiness`,
      "name": "GeekBytes IT Solutions",
      "url": siteUrl,
      "image": `${siteUrl}/images/og-image.png`,
      "description": "GeekBytes provides web development, mobile apps, AI chatbots, GoHighLevel CRM, cloud architecture, video editing, and graphic design services worldwide.",
      "email": siteConfig.email,
      "priceRange": "$12 - $50",
      "areaServed": "Worldwide",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "IT Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "WordPress Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Chatbots & Automation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile App Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "GoHighLevel CRM" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Software Solutions" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cloud Architecture" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Video Editing" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Graphic Design & Branding" } }
        ]
      }
    }
  ]
};
---

<BaseLayout
  title={siteConfig.meta.title}
  description={siteConfig.meta.description}
  ogImage={siteConfig.meta.ogImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What services does GeekBytes offer?", "acceptedAnswer": { "@type": "Answer", "text": "GeekBytes offers web development, WordPress development, AI chatbot integration, mobile app development (iOS & Android), GoHighLevel CRM setup, custom software development, cloud architecture (AWS, GCP, Azure), video editing, and graphic design & branding." } },
        { "@type": "Question", "name": "How much does GeekBytes charge for services?", "acceptedAnswer": { "@type": "Answer", "text": "GeekBytes pricing starts at $12 per hour. Project-based pricing is also available. We offer flexible engagement models for startups, SMEs, and enterprises worldwide." } },
        { "@type": "Question", "name": "Where is GeekBytes based and do they work internationally?", "acceptedAnswer": { "@type": "Answer", "text": "GeekBytes is a remote-first IT solutions company serving clients across the United States, Europe, Australia, the Middle East, and worldwide." } },
        { "@type": "Question", "name": "When was GeekBytes founded?", "acceptedAnswer": { "@type": "Answer", "text": "GeekBytes was founded in 2020 with the mission to provide high-quality, affordable technology solutions to businesses globally." } },
        { "@type": "Question", "name": "What technologies does GeekBytes specialize in?", "acceptedAnswer": { "@type": "Answer", "text": "GeekBytes specializes in React, Next.js, Node.js, Python, Flutter, React Native, WordPress, WooCommerce, Shopify, AWS, Google Cloud, Azure, Docker, MongoDB, PostgreSQL, GoHighLevel CRM, and more." } },
        { "@type": "Question", "name": "Can GeekBytes build an AI chatbot for my business?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. GeekBytes designs and integrates AI-powered chatbots using GPT-4, Dialogflow, and custom LLM solutions for customer support, lead generation, appointment booking, and workflow automation." } },
        { "@type": "Question", "name": "How long does it take GeekBytes to build a website?", "acceptedAnswer": { "@type": "Answer", "text": "A standard business website typically takes 1–3 weeks. Complex eCommerce platforms or custom web applications may take 4–8 weeks depending on scope." } },
        { "@type": "Question", "name": "How do I contact GeekBytes to start a project?", "acceptedAnswer": { "@type": "Answer", "text": "You can contact GeekBytes by emailing info@geekbytestech.com or by filling out the contact form on the GeekBytes website. A team member typically responds within 24 hours." } }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["#hero h1", "#company h2", "#faq"]
      },
      "url": siteUrl
    })} />
  </Fragment>

  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <HeroSection />
  <AboutSection />
  <SkillsSection />
  <ServicesSection />
  <CtaBanner
    heading="Not sure which service you need?"
    subtext="Book a free 30-minute call — we'll assess your project and recommend the right approach."
    primaryLabel="Book a Free Call"
    primaryHref="https://calendly.com/geekbytessolutions"
    primaryExternal={true}
    secondaryLabel="Send a Message"
    secondaryHref="/#contact"
  />
  <ProjectsSection />
  <CtaBanner
    heading="Like what you see? Let's build yours."
    subtext="50+ projects delivered. Your business could be next."
    primaryLabel="Start Your Project"
    primaryHref="/#contact"
    secondaryLabel="View Case Studies"
    secondaryHref="/case-studies"
  />
  <TestimonialsSection />
  <FaqSection />
  <ContactSection />

  <Fragment slot="footer">
    <FloatingChat />
    <ChatBot />
    <Footer />
  </Fragment>
</BaseLayout>

<script>
import '../scripts/active-nav.js';
import '../scripts/project-filter.js';
import '../scripts/form-validation.js';
import '../scripts/scroll-animations.js';
</script>
