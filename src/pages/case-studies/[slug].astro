---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FloatingChat from '../../components/FloatingChat.astro';
import ChatBot from '../../components/ChatBot.astro';
import { projects, type Project } from '../../data/projects';
import { caseStudies } from '../../data/case-studies';
import { projectScreenshotUrl } from '../../utils/project-screenshot';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const caseStudy = caseStudies[project.slug];

const categoryLabel: Record<string, string> = {
  ecommerce: "eCommerce",
  business: "Business",
  hospitality: "Hospitality",
  healthcare: "Healthcare",
  automotive: "Automotive",
  "mobile-apps": "Mobile App",
  "saas-tech": "SaaS & Tech",
};

// Map category to the most relevant service page
const serviceMap: Record<string, { label: string; slug: string }> = {
  ecommerce:    { label: "eCommerce Store Development", slug: "web-development" },
  business:     { label: "Web Development", slug: "web-development" },
  hospitality:  { label: "Web Development", slug: "web-development" },
  healthcare:   { label: "Web Development", slug: "web-development" },
  automotive:   { label: "Web Development", slug: "web-development" },
  "mobile-apps":{ label: "Mobile App Development", slug: "mobile-app-development" },
  "saas-tech":  { label: "Custom Software Solutions", slug: "custom-software" },
};
const relatedService = serviceMap[project.category] ?? { label: "Our Services", slug: "" };

// Related case studies — same category, exclude current
const relatedProjects: Project[] = projects
  .filter(p => p.slug !== project.slug && p.category === project.category && caseStudies[p.slug])
  .slice(0, 2);

// Build short summary for the at-a-glance box
const challengeShort = caseStudy?.challenge
  ? caseStudy.challenge.slice(0, 120).trimEnd() + "…"
  : project.description.slice(0, 120) + "…";
const resultShort = caseStudy?.outcomes
  ? caseStudy.outcomes.slice(0, 110).trimEnd() + "…"
  : "See results below.";
---

<BaseLayout
  title={`Case Study: ${project.name} — GeekBytes`}
  description={`How GeekBytes built ${project.name}: ${project.description}`}
  ogImage={projectScreenshotUrl(project.url)}
>
  <Fragment slot="header">
    <Navbar />
  </Fragment>

  <main class="bg-brand-black text-brand-white min-h-screen">

    <!-- Hero -->
    <section class="pt-32 pb-16 px-4">
      <div class="max-w-3xl mx-auto">
        <a href="/case-studies" class="inline-flex items-center gap-2 text-brand-accent text-sm mb-8 hover:underline">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          All Case Studies
        </a>

        <div class="flex flex-wrap gap-2 mb-5">
          <span class="text-xs px-3 py-1 rounded-full border border-brand-accent/50 text-brand-accent">
            {categoryLabel[project.category] ?? project.category}
          </span>
          {project.techTags.map((tag) => (
            <span class="text-xs px-3 py-1 rounded-full border border-white/20 text-gray-400">{tag}</span>
          ))}
        </div>

        <h1 class="text-4xl lg:text-5xl font-bold mb-4">{project.name}</h1>
        <p class="text-xl text-gray-400 leading-relaxed">{project.description}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-brand-accent text-white font-semibold px-5 py-2.5 rounded-full text-sm hover:bg-brand-accent/90 transition-colors"
          >
            Visit Live Site
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
          <a
            href="https://calendly.com/geekbytessolutions"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-white/20 text-brand-white/80 font-semibold px-5 py-2.5 rounded-full text-sm hover:border-brand-accent/50 hover:text-brand-white transition-colors"
          >
            Get Something Similar →
          </a>
        </div>
      </div>
    </section>

    <!-- At-a-glance summary box -->
    <section class="max-w-3xl mx-auto px-4 pb-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/10 rounded-2xl overflow-hidden border border-white/10">
        <div class="bg-brand-black p-5">
          <p class="text-xs text-gray-500 uppercase tracking-widest mb-1.5">Client Type</p>
          <p class="text-brand-white font-semibold text-sm">{categoryLabel[project.category] ?? project.category}</p>
        </div>
        <div class="bg-brand-black p-5">
          <p class="text-xs text-gray-500 uppercase tracking-widest mb-1.5">Tech Used</p>
          <p class="text-brand-white font-semibold text-sm">{project.techTags.slice(0, 2).join(", ")}</p>
        </div>
        <div class="bg-brand-black p-5 col-span-2 md:col-span-1">
          <p class="text-xs text-gray-500 uppercase tracking-widest mb-1.5">Challenge</p>
          <p class="text-gray-400 text-sm leading-relaxed">{challengeShort}</p>
        </div>
        <div class="bg-brand-black p-5 col-span-2 md:col-span-1">
          <p class="text-xs text-gray-500 uppercase tracking-widest mb-1.5">Result</p>
          <p class="text-gray-400 text-sm leading-relaxed">{resultShort}</p>
        </div>
      </div>
    </section>

    <!-- Stats bar — prefer case study stats, fall back to project stats -->
    {(() => {
      const stats = (caseStudy?.stats && caseStudy.stats.length > 0)
        ? caseStudy.stats
        : (project.stats && project.stats.length > 0 ? project.stats : null);
      return stats ? (
        <section class="border-y border-white/10 py-10 px-4">
          <div class="max-w-3xl mx-auto grid grid-cols-3 gap-6 text-center">
            {stats.map((stat) => (
              <div>
                <p class="text-3xl font-bold text-brand-accent">{stat.value}</p>
                <p class="text-gray-400 text-sm mt-1">{stat.label}</p>
              </div>
            ))}
          </div>
        </section>
      ) : null;
    })()}

    <!-- Body -->
    {caseStudy ? (
      <article class="max-w-3xl mx-auto px-4 py-16 space-y-14">

        <!-- Challenge -->
        <section>
          <h2 class="text-2xl font-bold mb-4">The Challenge</h2>
          <p class="text-gray-300 leading-relaxed">{caseStudy.challenge}</p>
        </section>

        <!-- What we built -->
        <section>
          <h2 class="text-2xl font-bold mb-6">What We Built</h2>
          <ul class="space-y-5">
            {caseStudy.steps.map((step, index) => (
              <li class="flex gap-4">
                <span class="w-8 h-8 rounded-full bg-brand-accent/10 border border-brand-accent/30 flex items-center justify-center text-brand-accent shrink-0 mt-0.5 text-sm font-bold">
                  {index + 1}
                </span>
                <div>
                  <p class="text-brand-white font-semibold">{step.title}</p>
                  <p class="text-gray-400 text-sm mt-1 leading-relaxed">{step.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <!-- Mid-page CTA — inserted after "What We Built" when reader intent is highest -->
        <section class="bg-gradient-to-r from-brand-accent/10 to-blue-500/5 border border-brand-accent/20 rounded-2xl p-7 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <p class="text-brand-white font-bold text-lg mb-1">Want something similar for your business?</p>
            <p class="text-gray-400 text-sm">We build fast. Most projects kick off within a week. Free consultation, no commitment.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href="https://calendly.com/geekbytessolutions"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-brand-accent text-white font-semibold px-5 py-2.5 rounded-full text-sm hover:bg-brand-accent/90 transition-colors whitespace-nowrap"
            >
              Book a Free Call
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a
              href="/#contact"
              class="inline-flex items-center justify-center gap-2 border border-white/20 text-brand-white/80 font-semibold px-5 py-2.5 rounded-full text-sm hover:border-white/40 hover:text-brand-white transition-colors whitespace-nowrap"
            >
              Send a Message
            </a>
          </div>
        </section>

        <!-- Tech stack -->
        <section>
          <h2 class="text-2xl font-bold mb-4">Tech Stack</h2>
          <div class="flex flex-wrap gap-3">
            {project.techTags.map((tech) => (
              <span class="text-sm px-3 py-1.5 rounded-lg border border-white/15 text-gray-300">{tech}</span>
            ))}
          </div>
        </section>

        <!-- Results -->
        <section class="bg-white/5 border border-white/10 rounded-2xl p-8">
          <h2 class="text-2xl font-bold mb-4">Results</h2>
          <p class="text-gray-300 leading-relaxed">{caseStudy.outcomes}</p>
        </section>

        <!-- Related Service block -->
        <section class="border border-white/10 rounded-2xl p-7 bg-white/3">
          <p class="text-xs text-gray-500 uppercase tracking-widest mb-4">Related Service</p>
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
            <div>
              <p class="text-brand-white font-bold text-lg mb-1">{relatedService.label}</p>
              <p class="text-gray-400 text-sm">This project was built using our {relatedService.label} service. See full details, pricing, and deliverables.</p>
            </div>
            <div class="flex flex-col gap-3 shrink-0">
              <a
                href={`/services/${relatedService.slug}`}
                class="inline-flex items-center justify-center gap-2 bg-brand-accent text-white font-semibold px-5 py-2.5 rounded-full text-sm hover:bg-brand-accent/90 transition-colors whitespace-nowrap"
              >
                View Service Details →
              </a>
              <a
                href="/#contact"
                class="inline-flex items-center justify-center gap-2 border border-white/20 text-brand-white/70 font-semibold px-5 py-2.5 rounded-full text-sm hover:border-white/40 hover:text-brand-white transition-colors whitespace-nowrap"
              >
                Get a Quote
              </a>
            </div>
          </div>
        </section>

        <!-- Related case studies -->
        {relatedProjects.length > 0 && (
          <section>
            <p class="text-xs text-gray-500 uppercase tracking-widest mb-5">More in this category</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedProjects.map((p) => (
                <a
                  href={`/case-studies/${p.slug}`}
                  class="group bg-white/[0.03] border border-white/8 rounded-2xl overflow-hidden hover:border-brand-accent/30 transition-all duration-300"
                >
                  <div class="aspect-[16/9] bg-white/5 overflow-hidden">
                    <img src={projectScreenshotUrl(p.url)} alt={`${p.name} website preview`} width="600" height="400" loading="lazy" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500 opacity-70 group-hover:opacity-100" />
                  </div>
                  <div class="p-5">
                    <h3 class="text-sm font-bold text-brand-white group-hover:text-brand-accent transition-colors mb-1">{p.name}</h3>
                    <p class="text-xs text-brand-white/40 leading-relaxed line-clamp-2">{p.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- CTA -->
        <section class="text-center pt-4">
          <p class="text-gray-400 mb-6">Want results like these for your business?</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="https://calendly.com/geekbytessolutions" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-brand-accent text-white font-semibold px-6 py-3 rounded-full hover:bg-brand-accent/90 transition-colors">
              Book a Free Strategy Call →
            </a>
            <a href="/case-studies" class="text-sm text-brand-white/50 hover:text-brand-accent transition-colors font-medium">
              View all case studies →
            </a>
          </div>
        </section>

      </article>
    ) : (
      <div class="max-w-3xl mx-auto px-4 py-16 text-center">
        <p class="text-gray-400">Detailed case study coming soon.</p>
        <a href="/#contact" class="inline-flex items-center gap-2 mt-6 bg-brand-accent text-white font-semibold px-6 py-3 rounded-full hover:bg-brand-accent/90 transition-colors">
          Ask Us About This Project
        </a>
      </div>
    )}

  </main>

  <FloatingChat />
  <ChatBot />

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
