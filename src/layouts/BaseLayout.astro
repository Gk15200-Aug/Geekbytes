---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-image.png',
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.geekbytestech.com';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Always resolve OG image to an absolute URL so social crawlers can fetch it
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : `${siteUrl}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="GeekBytes" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GeekBytes — Modern IT Solutions & Software Development" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content="GeekBytes — Modern IT Solutions & Software Development" />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <link rel="apple-touch-icon" href="/images/logo.jpeg" />

    <!-- Optional Inter — loads after first paint; system-ui used until then -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all';document.documentElement.classList.add('fonts-loaded')"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang — same URL serves EN/DE/ES via client-side i18n -->
    <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Page-specific head content (JSON-LD, hreflang, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <header role="banner">
      <slot name="header" />
    </header>

    <main role="main" id="main-content">
      <slot />
    </main>

    <footer role="contentinfo">
      <slot name="footer" />
    </footer>

    <script is:inline src="https://va.vercel-scripts.com/v1/script.js" defer></script>

    <script>
    import '../scripts/mobile-menu.js';
    window.addEventListener('load', () => {
      import('../scripts/smooth-scroll.js');
    });
    </script>

    {import.meta.env.PROD && (
      <script is:inline>
        window.addEventListener('load', function () {
          setTimeout(function () {
            if (document.querySelector('script[src*="speed-insights"]')) return;
            var s = document.createElement('script');
            s.src = '/_vercel/speed-insights/script.js';
            s.defer = true;
            document.head.appendChild(s);
          }, 5000);
        });
      </script>
    )}
  </body>
</html>
