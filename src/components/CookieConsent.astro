---
// Cookie Consent Banner — GDPR compliant
// Shows on first visit, remembers choice, blocks analytics until accepted
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-[100] hidden"
  role="dialog"
  aria-label="Cookie consent"
  aria-describedby="cookie-desc"
>
  <div class="max-w-4xl mx-auto px-4 pb-4">
    <div class="bg-brand-black/95 backdrop-blur-xl border border-white/10 rounded-2xl p-5 md:p-6 shadow-2xl shadow-black/50">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <!-- Text -->
        <div class="flex-1 min-w-0">
          <p id="cookie-desc" class="text-sm text-brand-white/70 leading-relaxed">
            We use cookies to analyze site traffic and improve your experience. No personal data is sold or shared with third parties.
            <a href="/privacy-policy" class="text-brand-accent hover:underline underline-offset-2 ml-1">Privacy Policy</a>
          </p>
        </div>

        <!-- Buttons -->
        <div class="flex items-center gap-3 shrink-0">
          <button
            id="cookie-reject"
            class="px-4 py-2 text-sm font-medium text-brand-white/60 border border-white/15 rounded-full hover:border-white/30 hover:text-brand-white transition-colors"
          >
            Reject
          </button>
          <button
            id="cookie-accept"
            class="px-5 py-2 text-sm font-semibold text-brand-black bg-brand-accent rounded-full hover:bg-brand-accent/90 transition-colors"
          >
            Accept
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  var COOKIE_NAME = 'gb_cookie_consent';
  var banner = document.getElementById('cookie-banner');
  var acceptBtn = document.getElementById('cookie-accept');
  var rejectBtn = document.getElementById('cookie-reject');

  function getCookie(name) {
    var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? match[2] : null;
  }

  function setCookie(name, value, days) {
    var expires = '';
    if (days) {
      var date = new Date();
      date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
      expires = '; expires=' + date.toUTCString();
    }
    document.cookie = name + '=' + value + expires + '; path=/; SameSite=Lax; Secure';
  }

  function hideBanner() {
    if (banner) banner.classList.add('hidden');
  }

  function showBanner() {
    if (banner) banner.classList.remove('hidden');
  }

  function loadAnalytics() {
    // Load GA4 (Google Analytics 4) with custom event support
    if (!document.querySelector('script[src*="googletagmanager"]')) {
      var g = document.createElement('script');
      g.async = true;
      g.src = 'https://www.googletagmanager.com/gtag/js?id=G-WJKCVFWSWH';
      document.head.appendChild(g);

      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-WJKCVFWSWH', {
        send_page_view: true,
        cookie_flags: 'SameSite=Lax;Secure'
      });

      // Custom event tracking
      setupCustomEvents();
    }
  }

  function setupCustomEvents() {
    // Track CTA clicks (Book a Call, Contact Us)
    document.querySelectorAll('a[href*="calendly"]').forEach(function(el) {
      el.addEventListener('click', function() {
        window.gtag && window.gtag('event', 'cta_click', {
          event_category: 'engagement',
          event_label: 'book_a_call',
          link_url: el.getAttribute('href')
        });
      });
    });

    // Track contact form submissions
    document.querySelectorAll('form[action*="formsubmit"]').forEach(function(form) {
      form.addEventListener('submit', function() {
        window.gtag && window.gtag('event', 'form_submit', {
          event_category: 'conversion',
          event_label: 'contact_form'
        });
      });
    });

    // Track chatbot opens
    var chatBtn = document.getElementById('floating-chat-btn');
    if (chatBtn) {
      chatBtn.addEventListener('click', function() {
        window.gtag && window.gtag('event', 'chatbot_open', {
          event_category: 'engagement',
          event_label: 'floating_chat'
        });
      });
    }

    // Track service page visits as engagement
    if (window.location.pathname.startsWith('/services/')) {
      window.gtag && window.gtag('event', 'view_service', {
        event_category: 'engagement',
        event_label: window.location.pathname.split('/').pop()
      });
    }

    // Track blog scroll depth (50% and 100%)
    if (window.location.pathname.startsWith('/blog/') && window.location.pathname !== '/blog/') {
      var scrollTracked = {};
      window.addEventListener('scroll', function() {
        var scrollPercent = Math.round((window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100);
        if (scrollPercent >= 50 && !scrollTracked['50']) {
          scrollTracked['50'] = true;
          window.gtag && window.gtag('event', 'scroll_depth', {
            event_category: 'engagement',
            event_label: '50_percent',
            page_path: window.location.pathname
          });
        }
        if (scrollPercent >= 90 && !scrollTracked['90']) {
          scrollTracked['90'] = true;
          window.gtag && window.gtag('event', 'scroll_depth', {
            event_category: 'engagement',
            event_label: '90_percent',
            page_path: window.location.pathname
          });
        }
      }, { passive: true });
    }

    // Track outbound link clicks
    document.querySelectorAll('a[target="_blank"]').forEach(function(el) {
      el.addEventListener('click', function() {
        window.gtag && window.gtag('event', 'outbound_click', {
          event_category: 'engagement',
          event_label: el.getAttribute('href')
        });
      });
    });
  }

  // Check existing consent
  var consent = getCookie(COOKIE_NAME);

  if (consent === 'accepted') {
    loadAnalytics();
  } else if (consent === 'rejected') {
    // Do nothing — no analytics
  } else {
    // No choice made yet — show banner
    showBanner();
  }

  if (acceptBtn) {
    acceptBtn.addEventListener('click', function() {
      setCookie(COOKIE_NAME, 'accepted', 365);
      hideBanner();
      loadAnalytics();
    });
  }

  if (rejectBtn) {
    rejectBtn.addEventListener('click', function() {
      setCookie(COOKIE_NAME, 'rejected', 365);
      hideBanner();
    });
  }
})();
</script>
