---
// GeekBytes inline SVG logo — replaces logo.jpeg for crisp rendering at all sizes
---

<svg
  width="36"
  height="36"
  viewBox="0 0 36 36"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="GeekBytes logo"
  role="img"
>
  <!-- Background rounded square -->
  <rect width="36" height="36" rx="8" fill="#1E40AF"/>
  <rect width="36" height="36" rx="8" fill="url(#gb-grad)"/>

  <!-- "G" letterform -->
  <text
    x="5"
    y="26"
    font-family="'Inter', 'Segoe UI', system-ui, sans-serif"
    font-size="22"
    font-weight="800"
    fill="white"
    letter-spacing="-1"
  >GB</text>

  <defs>
    <linearGradient id="gb-grad" x1="0" y1="0" x2="36" y2="36" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="100%" stop-color="#1D4ED8"/>
    </linearGradient>
  </defs>
</svg>
