---
// Trust & credibility bar — update the href values once profiles are created
const platforms = [
  {
    name: "Google",
    rating: "4.8",
    reviews: "Verified Reviews",
    href: "https://share.google/uzkKhnpFlFwRVnL1L",
    verified: true,
    color: "#4285F4",
    logo: `<svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>`,
  },
  {
    name: "Clutch",
    rating: "5.0",
    reviews: "Leave a Review",
    href: "https://clutch.co/profile/geekbytes",
    verified: false,
    color: "#E5260C",
    logo: `<svg viewBox="0 0 40 40" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="20" fill="#E5260C"/><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="white" font-size="16" font-weight="bold" font-family="sans-serif">C</text></svg>`,
  },
  {
    name: "G2",
    rating: "5.0",
    reviews: "Leave a Review",
    href: "https://www.g2.com/products/geekbytes/reviews",
    verified: false,
    color: "#FF492C",
    logo: `<svg viewBox="0 0 40 40" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="20" fill="#FF492C"/><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="white" font-size="14" font-weight="bold" font-family="sans-serif">G2</text></svg>`,
  },
  {
    name: "Trustpilot",
    rating: "5.0",
    reviews: "Leave a Review",
    href: "https://www.trustpilot.com/evaluate/geekbytestech.com",
    verified: false,
    color: "#00B67A",
    logo: `<svg viewBox="0 0 40 40" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="20" fill="#00B67A"/><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="white" font-size="11" font-weight="bold" font-family="sans-serif">TP</text></svg>`,
  },
];
---

<section class="py-14 border-t border-white/10">
  <div class="max-w-container mx-auto px-4">

    <p class="text-center text-xs font-semibold tracking-widest text-brand-white/30 uppercase mb-8">
      Verified & Reviewed On
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      {platforms.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${p.name} — ${p.reviews}`}
          class="group flex items-center gap-3 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-xl px-5 py-3.5 transition-all duration-200"
        >
          <!-- Platform logo -->
          <span set:html={p.logo} />

          <!-- Info -->
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-brand-white font-semibold text-sm">{p.name}</span>
              {p.verified && (
                <span class="text-[10px] bg-green-500/20 text-green-400 border border-green-500/30 px-1.5 py-0.5 rounded-full font-medium">
                  Verified
                </span>
              )}
              {!p.verified && (
                <span class="text-[10px] bg-brand-accent/10 text-brand-accent border border-brand-accent/20 px-1.5 py-0.5 rounded-full font-medium">
                  + Add Review
                </span>
              )}
            </div>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="text-yellow-400 text-xs">★★★★★</span>
              <span class="text-gray-500 text-xs">{p.reviews}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- CTA nudge -->
    <p class="text-center text-gray-500 text-xs mt-6">
      A past client? Your review helps other businesses find us —
      <a href="https://share.google/uzkKhnpFlFwRVnL1L" target="_blank" rel="noopener noreferrer" class="text-brand-accent hover:underline">
        takes 30 seconds on Google
      </a>
    </p>

  </div>
</section>
