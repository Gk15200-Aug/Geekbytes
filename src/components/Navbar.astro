---
import Logo from './icons/Logo.astro';
import { navItems, contactButton } from '../data/navigation';

const navI18nKeys = ['nav.home', 'nav.about', 'nav.skills', 'nav.services', 'nav.projects', 'nav.testimonials'];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-brand-black/80 backdrop-blur-md border-b border-white/10"
  aria-label="Main navigation"
>
  <div class="max-w-container mx-auto px-4 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/#hero" class="flex items-center gap-2 min-w-[44px] min-h-[44px]" aria-label="GeekBytes Home">
      <Logo />
      <span class="text-brand-white font-bold text-lg">GeekBytes</span>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="hidden lg:flex items-center gap-1">
      {navItems.map((item, i) => (
        <li>
          <a
            href={'/' + item.href}
            data-section={item.href.replace('#', '')}
            data-i18n={navI18nKeys[i]}
            class="relative px-3 py-2 text-sm text-brand-white/70 hover:text-brand-white transition-colors rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black min-w-[44px] min-h-[44px] inline-flex items-center"
          >
            {item.label}
            <span class="absolute bottom-0 left-3 right-3 h-0.5 bg-brand-accent transition-transform duration-300 origin-left nav-indicator" style="transform: scaleX(0)"></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Right side: Language switcher + Contact button + Hamburger -->
    <div class="flex items-center gap-2">
      <!-- Language Switcher -->
      <div class="relative" id="lang-switcher">
        <button
          id="lang-toggle"
          class="flex items-center gap-1.5 px-2.5 py-2 text-sm text-brand-white/70 hover:text-brand-white transition-colors rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black min-h-[44px]"
          aria-label="Switch language"
          aria-expanded="false"
          aria-controls="lang-dropdown"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span id="lang-current" class="font-medium tracking-wide">EN</span>
          <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown -->
        <div
          id="lang-dropdown"
          role="menu"
          aria-labelledby="lang-toggle"
          class="hidden absolute right-0 top-full mt-1 min-w-[80px] bg-brand-black border border-white/15 rounded-lg overflow-hidden shadow-xl z-50"
        >
          <button class="lang-option w-full px-4 py-2.5 text-sm text-brand-white/70 hover:bg-white/5 hover:text-brand-white transition-colors text-left flex items-center gap-2" data-lang="en" role="menuitem">
            🇺🇸 <span>EN</span>
          </button>
          <button class="lang-option w-full px-4 py-2.5 text-sm text-brand-white/70 hover:bg-white/5 hover:text-brand-white transition-colors text-left flex items-center gap-2" data-lang="de" role="menuitem">
            🇩🇪 <span>DE</span>
          </button>
          <button class="lang-option w-full px-4 py-2.5 text-sm text-brand-white/70 hover:bg-white/5 hover:text-brand-white transition-colors text-left flex items-center gap-2" data-lang="es" role="menuitem">
            🇪🇸 <span>ES</span>
          </button>
        </div>
      </div>

      <!-- Contact Us pill button (visible on desktop) -->
      <a
        href={'/' + contactButton.href}
        data-i18n="nav.contact"
        class="hidden lg:inline-flex btn-primary text-sm px-5 py-2 min-h-[44px] items-center focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black"
      >
        {contactButton.label}
      </a>

      <!-- Hamburger Menu Button (visible on mobile/tablet) -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden flex items-center justify-center w-11 h-11 text-brand-white rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-i18n-aria="nav.aria.menu_open"
        aria-label="Open navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay — OUTSIDE nav to avoid stacking context issues -->
<div
  id="mobile-menu"
  class="hidden lg:hidden"
  style="position: fixed; inset: 0; z-index: 9999; background: #000000;"
  aria-hidden="true"
>
  <!-- Close button -->
  <div class="flex justify-between items-center p-4">
    <!-- Mobile language switcher -->
    <div class="flex items-center gap-2 px-2">
      <button class="lang-option px-3 py-1.5 text-sm text-brand-white/60 hover:text-brand-white transition-colors rounded border border-white/10 hover:border-white/30" data-lang="en">🇺🇸 EN</button>
      <button class="lang-option px-3 py-1.5 text-sm text-brand-white/60 hover:text-brand-white transition-colors rounded border border-white/10 hover:border-white/30" data-lang="de">🇩🇪 DE</button>
      <button class="lang-option px-3 py-1.5 text-sm text-brand-white/60 hover:text-brand-white transition-colors rounded border border-white/10 hover:border-white/30" data-lang="es">🇪🇸 ES</button>
    </div>
    <button
      class="mobile-menu-close w-11 h-11 flex items-center justify-center text-brand-white"
      data-i18n-aria="nav.aria.menu_close"
      aria-label="Close menu"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <ul class="flex flex-col items-center justify-center h-[calc(100%-80px)] gap-8">
    {navItems.map((item, i) => (
      <li>
        <a
          href={'/' + item.href}
          data-section={item.href.replace('#', '')}
          data-i18n={navI18nKeys[i]}
          class="text-2xl text-brand-white/80 hover:text-brand-white transition-colors px-4 py-3 min-w-[44px] min-h-[44px] inline-flex items-center"
        >
          {item.label}
        </a>
      </li>
    ))}
    <li>
      <a
        href={'/' + contactButton.href}
        data-i18n="nav.contact"
        class="btn-primary text-lg px-8 py-3 min-h-[44px] inline-flex items-center"
      >
        {contactButton.label}
      </a>
    </li>
  </ul>
</div>
