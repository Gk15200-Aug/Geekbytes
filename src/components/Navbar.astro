---
import Logo from './icons/Logo.astro';
import { navItems, contactButton } from '../data/navigation';

const navI18nKeys = ['nav.home', 'nav.about', 'nav.skills', 'nav.services', 'nav.projects', 'nav.testimonials'];
---

<nav
  id="site-nav"
  class="site-nav fixed top-0 left-0 right-0 z-50"
  aria-label="Main navigation"
>
  <div class="site-nav-inner max-w-container mx-auto px-4 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/#hero" class="flex items-center gap-2 min-w-[44px] min-h-[44px]" aria-label="GeekBytes Home">
      <Logo />
      <span class="text-brand-white font-bold text-lg">GeekBytes</span>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="hidden lg:flex items-center gap-1">
      {navItems.map((item, i) => (
        <li>
          <a
            href={'/' + item.href}
            data-section={item.href.replace('#', '')}
            data-i18n={navI18nKeys[i]}
            class="relative px-3 py-2 text-sm text-brand-white/70 hover:text-brand-white transition-colors rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black min-w-[44px] min-h-[44px] inline-flex items-center"
          >
            {item.label}
            <span class="absolute bottom-0 left-3 right-3 h-0.5 bg-brand-accent transition-transform duration-300 origin-left nav-indicator" style="transform: scaleX(0)"></span>
          </a>
        </li>
      ))}
      <li>
        <a href="/about" class="relative px-3 py-2 text-sm text-brand-white/70 hover:text-brand-white transition-colors rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black min-w-[44px] min-h-[44px] inline-flex items-center">
          About
        </a>
      </li>
      <li>
        <a href="/services" class="relative px-3 py-2 text-sm text-brand-white/70 hover:text-brand-white transition-colors rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black min-w-[44px] min-h-[44px] inline-flex items-center">
          All Services
        </a>
      </li>
      <li>
        <a href="/blog" class="relative px-3 py-2 text-sm text-brand-white/70 hover:text-brand-white transition-colors rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black min-w-[44px] min-h-[44px] inline-flex items-center">
          Blog
        </a>
      </li>
      <li>
        <a href="/case-studies" class="relative px-3 py-2 text-sm text-brand-white/70 hover:text-brand-white transition-colors rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black min-w-[44px] min-h-[44px] inline-flex items-center">
          Case Studies
        </a>
      </li>
    </ul>

    <!-- Right side: Contact button + Hamburger -->
    <div class="flex items-center gap-2">
      <!-- Book a Call (Calendly) — desktop -->
      <a
        href="https://calendly.com/geekbytessolutions"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-2 min-h-[44px] rounded-full border border-brand-accent/50 text-brand-accent hover:bg-brand-accent/10 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Book a Call
      </a>
      <!-- Contact Us pill button (visible on desktop) -->
      <a
        href={'/' + contactButton.href}
        data-i18n="nav.contact"
        class="hidden lg:inline-flex btn-primary text-sm px-5 py-2 min-h-[44px] items-center focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black"
      >
        {contactButton.label}
      </a>

      <!-- Hamburger Menu Button (visible on mobile/tablet) -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden flex items-center justify-center w-11 h-11 text-brand-white rounded focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-i18n-aria="nav.aria.menu_open"
        aria-label="Open navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay — OUTSIDE nav to avoid stacking context issues -->
<div
  id="mobile-menu"
  class="hidden lg:hidden"
  style="position: fixed; inset: 0; z-index: 9999; background: #000000;"
  aria-hidden="true"
>
  <!-- Close button -->
  <div class="flex justify-between items-center p-4">
    <div></div>
    <button
      class="mobile-menu-close w-11 h-11 flex items-center justify-center text-brand-white"
      data-i18n-aria="nav.aria.menu_close"
      aria-label="Close menu"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <ul class="flex flex-col items-center justify-center h-[calc(100%-80px)] gap-8">
    {navItems.map((item, i) => (
      <li>
        <a
          href={'/' + item.href}
          data-section={item.href.replace('#', '')}
          data-i18n={navI18nKeys[i]}
          class="text-2xl text-brand-white/80 hover:text-brand-white transition-colors px-4 py-3 min-w-[44px] min-h-[44px] inline-flex items-center"
        >
          {item.label}
        </a>
      </li>
    ))}
    <li>
      <a href="/about" class="text-2xl text-brand-white/80 hover:text-brand-white transition-colors px-4 py-3 min-w-[44px] min-h-[44px] inline-flex items-center">
        About
      </a>
    </li>
    <li>
      <a href="/services" class="text-2xl text-brand-white/80 hover:text-brand-white transition-colors px-4 py-3 min-w-[44px] min-h-[44px] inline-flex items-center">
        All Services
      </a>
    </li>
    <li>
      <a href="/blog" class="text-2xl text-brand-white/80 hover:text-brand-white transition-colors px-4 py-3 min-w-[44px] min-h-[44px] inline-flex items-center">
        Blog
      </a>
    </li>
    <li>
      <a href="/case-studies" class="text-2xl text-brand-white/80 hover:text-brand-white transition-colors px-4 py-3 min-w-[44px] min-h-[44px] inline-flex items-center">
        Case Studies
      </a>
    </li>
    <li>
      <a
        href="https://calendly.com/geekbytessolutions"
        target="_blank"
        rel="noopener noreferrer"
        class="text-2xl text-brand-accent font-semibold hover:text-brand-white transition-colors px-4 py-3 inline-flex items-center gap-2"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Book a Call
      </a>
    </li>
    <li>
      <a
        href={'/' + contactButton.href}
        data-i18n="nav.contact"
        class="btn-primary text-lg px-8 py-3 min-h-[44px] inline-flex items-center"
      >
        {contactButton.label}
      </a>
    </li>
  </ul>
</div>
