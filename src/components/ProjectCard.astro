---
// ProjectCard — Individual project card with thumbnail, tech tags, link to live site
import type { ProjectStat } from '../data/projects';

interface Props {
  name: string;
  description: string;
  thumbnail: string;
  techTags: string[];
  category: string;
  url: string;
  stats?: ProjectStat[];
}

const { name, description, thumbnail, techTags, category, url, stats } = Astro.props;
---

<div
  class="animate-on-scroll opacity-0 translate-y-4 transition-all duration-700 group bg-white/5 rounded-2xl border border-white/10 overflow-hidden hover:-translate-y-1 hover:border-brand-accent/30"
  data-category={category}
>
  <!-- Thumbnail area -->
  <a href={url} target="_blank" rel="nofollow noopener noreferrer" class="block relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-brand-accent/5 via-brand-black to-brand-accent/10">
    <!-- Website screenshot using Google's thumbnail service -->
    <img
      src={`https://s0.wp.com/mshots/v1/${encodeURIComponent(url)}?w=600&h=400`}
      alt={`${name} website preview`}
      class="w-full h-full object-cover object-top"
      loading="lazy"
    />

    <!-- "Visit Website" hover overlay -->
    <div class="absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <span class="px-5 py-2 rounded-full border border-brand-accent text-brand-accent text-sm font-medium">
        Visit Website
      </span>
    </div>
  </a>

  <!-- Card body -->
  <div class="p-5">
    <!-- Tech tags -->
    <div class="flex flex-wrap gap-2">
      {techTags.map((tag) => (
        <span class="text-xs px-2 py-1 rounded-full border border-brand-accent/50 text-brand-accent">
          {tag}
        </span>
      ))}
    </div>

    <!-- Project name -->
    <p class="text-lg font-bold text-brand-white mt-3">
      <a href={url} target="_blank" rel="nofollow noopener noreferrer" class="hover:text-brand-accent transition-colors">
        {name}
      </a>
    </p>

    <!-- Description -->
    <p class="text-sm text-brand-white/60 mt-1 line-clamp-2">{description}</p>

    <!-- Stats row (conditional) -->
    {stats && stats.length > 0 && (
      <div class="flex items-center gap-4 mt-4 pt-4 border-t border-white/10">
        {stats.map((stat, index) => (
          <div class:list={["flex flex-col", index > 0 && "pl-4 border-l border-white/10"]}>
            <span class="text-lg font-bold text-brand-accent">{stat.value}</span>
            <span class="text-xs text-brand-white/50">{stat.label}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</div>
