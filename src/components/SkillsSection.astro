---
// Skills Section — 6 category cards with technology grids
import { skillCategories } from '../data/skills';

// Category header icons only (6 small SVGs — kept for visual hierarchy)
const categoryIcons: Record<string, string> = {
  monitor: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  server: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" /></svg>`,
  mobile: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>`,
  cloud: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" /></svg>`,
  cms: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h18v18H3V3zm3 6h12M6 12h12M6 15h8" /></svg>`,
  tool: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1 5.1a2.121 2.121 0 01-3-3l5.1-5.1m0 0L8.5 8.5m2.92 6.67l4.069-4.069m0 0l5.1-5.1a2.121 2.121 0 00-3-3l-5.1 5.1" /></svg>`,
};

// Abbreviated labels for tech icons — avoids 45+ inline SVGs in the HTML output
const techLabel: Record<string, string> = {
  react: 'Re', vue: 'Vu', angular: 'Ng', html5: 'H5', css3: 'C3',
  javascript: 'JS', typescript: 'TS', tailwind: 'TW', nextjs: 'Nx',
  nodejs: 'No', python: 'Py', java: 'Jv', php: 'Ph', go: 'Go',
  django: 'Dj', express: 'Ex', laravel: 'La',
  flutter: 'Fl', reactnative: 'RN', swift: 'Sw', kotlin: 'Kt',
  dart: 'Da', firebase: 'Fb',
  aws: 'AW', gcp: 'GC', azure: 'Az', docker: 'Do', mongodb: 'Mg',
  postgresql: 'PG', mysql: 'My', redis: 'Rd',
  wordpress: 'WP', woocommerce: 'Wc', shopify: 'Sh', elementor: 'El',
  webflow: 'Wf', ghl: 'GH',
  git: 'Gt', github: 'Gh', figma: 'Fi', premiere: 'Pr',
  aftereffects: 'Ae', photoshop: 'Ps', illustrator: 'Ai', canva: 'Ca',
};
---

<section id="skills" aria-labelledby="skills-heading" class="bg-brand-black py-20 lg:py-24">
  <div class="max-w-container mx-auto px-4">
    <!-- Section header -->
    <div class="text-center mb-14">
      <span data-i18n="skills.label" class="section-label">OUR EXPERTISE</span>
      <h2 id="skills-heading" data-i18n="skills.heading" class="section-heading mt-4">Our Core Tech Stack</h2>
      <p data-i18n="skills.subtext" class="mt-4 text-brand-white/60 max-w-2xl mx-auto leading-relaxed">
        We go deep, not wide. These are the tools we use daily and know inside-out — not a list of everything we've ever installed.
      </p>
    </div>

    <!-- Skills grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category) => (
        <div class="card-hover bg-white/5 rounded-2xl border border-white/10 p-6">
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-brand-accent/10 flex items-center justify-center text-brand-accent">
              <Fragment set:html={categoryIcons[category.icon] || ''} />
            </div>
            <h3 data-i18n={`skill.${category.icon}`} class="text-lg font-bold text-brand-white">{category.name}</h3>
          </div>

          <!-- Technology grid -->
          <div class="grid grid-cols-3 gap-4">
            {category.skills.map((skill) => (
              <div class="flex flex-col items-center gap-1.5">
                <div class="w-10 h-10 rounded-lg bg-brand-accent/10 border border-brand-accent/20 flex items-center justify-center">
                  <span class="text-xs font-bold text-brand-accent tracking-wide">{techLabel[skill.icon] ?? skill.name.slice(0, 2).toUpperCase()}</span>
                </div>
                <span class="text-xs text-brand-white/60 text-center leading-tight">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
