---

<section id="skills" aria-labelledby="skills-heading" class="bg-brand-black py-20 lg:py-24">
  <div class="max-w-container mx-auto px-4">
    <!-- Section header -->
    <div class="text-center mb-14">
      <span class="section-label">OUR EXPERTISE</span>
      <h2 id="skills-heading" class="section-heading mt-4">Technologies We Master</h2>
      <p class="mt-4 text-brand-white/60 max-w-2xl mx-auto leading-relaxed">
        We build with modern, robust, and scalable technologies to ensure your project's long-term success.
      </p>
    </div>

    <!-- Skills grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category) => (
        <div class="animate-on-scroll opacity-0 translate-y-4 transition-all duration-700 bg-white/5 rounded-2xl border border-white/10 p-6">
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-brand-accent/10 flex items-center justify-center text-brand-accent">
              <Fragment set:html={categoryIcons[category.icon] || ''} />
            </div>
            <h3 class="text-lg font-bold text-brand-white">{category.name}</h3>
          </div>

          <!-- Technology grid -->
          <div class="grid grid-cols-3 gap-4">
            {category.skills.map((skill) => (
              <div class="flex flex-col items-center gap-1.5">
                <div class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center text-brand-white/70">
                  <Fragment set:html={techIcons[skill.icon] || `<span class="text-xs font-bold">${skill.name.slice(0, 2)}</span>`} />
                </div>
                <span class="text-xs text-brand-white/60 text-center leading-tight">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
