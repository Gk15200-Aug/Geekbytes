---
import { serviceInterestOptions } from '../data/contact';
import { siteConfig } from '../data/site';
---

<section id="contact" aria-labelledby="contact-heading" class="py-20 lg:py-24">
  <div class="max-w-container mx-auto px-4">
    <!-- Section Header -->
    <div class="mb-12">
      <p data-i18n="contact.label" class="section-label mb-4">CONTACT US</p>
      <h2 id="contact-heading" data-i18n="contact.heading" class="section-heading">Let's Build Something Great.</h2>
      <p data-i18n="contact.subtext" class="text-brand-white/60 mt-4 max-w-2xl">
        Ready to start your next project? Reach out to us and let's discuss how we can help your business grow with technology.
      </p>
    </div>

    <!-- Split Layout -->
    <div class="flex flex-col lg:flex-row gap-12">
      <!-- LEFT PANEL: Contact Info -->
      <div class="lg:w-2/5 space-y-8">
        <!-- Email -->
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p data-i18n="contact.email_label" class="text-brand-white font-medium">Email Us</p>
            <p class="text-brand-white/60 text-sm">{siteConfig.email}</p>
          </div>
        </div>

        <!-- Location -->
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p data-i18n="contact.location_label" class="text-brand-white font-medium">Location</p>
            <p class="text-brand-white/60 text-sm">{siteConfig.location}</p>
          </div>
        </div>

        <!-- What Happens Next -->
        <div class="border border-white/8 rounded-2xl p-5 bg-white/[0.02] space-y-3">
          <p class="text-xs text-gray-500 uppercase tracking-widest mb-1">What happens next</p>
          {[
            { step: "01", text: "We reply within 24 hours — often much faster." },
            { step: "02", text: "A 15-min discovery call to understand your project." },
            { step: "03", text: "You get a clear proposal with timeline and pricing." },
          ].map(({ step, text }) => (
            <div class="flex items-start gap-3">
              <span class="shrink-0 w-6 h-6 rounded-full bg-brand-accent/10 border border-brand-accent/20 text-brand-accent text-xs font-bold flex items-center justify-center mt-0.5">{step}</span>
              <p class="text-sm text-brand-white/55 leading-snug">{text}</p>
            </div>
          ))}
        </div>

        <!-- Micro testimonial -->
        <blockquote class="border-l-2 border-brand-accent pl-4 py-1">
          <p class="text-sm text-brand-white/60 leading-relaxed italic">"GeekBytes responded the same day, understood our requirements immediately, and delivered ahead of schedule. Highly recommend."</p>
          <footer class="mt-2 text-xs text-gray-500 not-italic">— Client, eCommerce brand · UK</footer>
        </blockquote>

        <!-- Social Icons -->
        <div class="flex gap-3 pt-0">
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-brand-accent/20 transition-colors">
            <svg class="w-5 h-5 text-brand-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-brand-accent/20 transition-colors">
            <svg class="w-5 h-5 text-brand-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- RIGHT PANEL: Form -->
      <div class="lg:w-3/5">
        <form id="contact-form" action="https://formsubmit.co/info@geekbytestech.com" method="POST" class="space-y-6">
          <!-- Formsubmit.co config -->
          <input type="hidden" name="_subject" value="New Inquiry from GeekBytes Website" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" style="display:none" />

          <!-- Full Name -->
          <div>
            <label for="full-name" data-i18n="contact.form.name" class="block text-brand-white text-sm font-medium mb-2">Full Name</label>
            <input
              type="text"
              id="full-name"
              name="full-name"
              required
              placeholder="John Doe"
              data-i18n-placeholder="contact.name_placeholder"
              class="bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-brand-white placeholder:text-brand-white/30 focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent w-full"
            />
          </div>

          <!-- Email Address -->
          <div>
            <label for="email" data-i18n="contact.form.email" class="block text-brand-white text-sm font-medium mb-2">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="john@example.com"
              data-i18n-placeholder="contact.email_placeholder"
              class="bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-brand-white placeholder:text-brand-white/30 focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent w-full"
            />
          </div>

          <!-- Phone Number -->
          <div>
            <label for="phone" class="block text-brand-white text-sm font-medium mb-2">
              <span data-i18n="contact.form.phone">Phone Number</span>
              <span data-i18n="contact.form.phone_optional" class="text-brand-white/40"> (Optional)</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+1 (555) 000-0000"
              data-i18n-placeholder="contact.phone_placeholder"
              class="bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-brand-white placeholder:text-brand-white/30 focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent w-full"
            />
          </div>

          <!-- Service Interest -->
          <div>
            <label data-i18n="contact.form.service" class="block text-brand-white text-sm font-medium mb-3">Service Interest</label>
            <div class="grid grid-cols-2 gap-3">
              {serviceInterestOptions.map((option) => (
                <label class="cursor-pointer">
                  <input type="radio" name="service-interest" value={option.value} class="sr-only peer" />
                  <div
                    data-i18n={`contact.option.${option.value}`}
                    class="border border-white/10 rounded-lg px-4 py-3 text-center text-sm text-brand-white/70 transition-all peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-white hover:border-white/20 min-h-[44px] flex items-center justify-center"
                  >
                    {option.label}
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- Budget Range -->
          <div>
            <label class="block text-brand-white text-sm font-medium mb-3">
              Budget Range <span class="text-brand-white/40">(Optional)</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {[
                { value: "under-500",       label: "Under $500" },
                { value: "500-1000",        label: "$500 – $1,000" },
                { value: "1000-5000",       label: "$1,000 – $5,000" },
                { value: "5000-10000",      label: "$5,000 – $10,000" },
                { value: "10000-25000",     label: "$10,000 – $25,000" },
                { value: "25000-plus",      label: "$25,000+" },
              ].map((range) => (
                <label class="cursor-pointer">
                  <input type="radio" name="budget-range" value={range.value} class="sr-only peer" />
                  <div class="border border-white/10 rounded-lg px-3 py-2.5 text-center text-sm text-brand-white/70 transition-all peer-checked:border-brand-accent peer-checked:bg-brand-accent/10 peer-checked:text-brand-white hover:border-white/20 min-h-[44px] flex items-center justify-center font-medium">
                    {range.label}
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- Project Details -->
          <div>
            <label for="message" data-i18n="contact.form.message" class="block text-brand-white text-sm font-medium mb-2">Project Details</label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              placeholder="Tell us about your project..."
              data-i18n-placeholder="contact.message_placeholder"
              class="bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-brand-white placeholder:text-brand-white/30 focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent w-full resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button type="submit" id="submit-btn" data-i18n="contact.form.submit" class="btn-primary w-full py-3">
            Send Message ✈
          </button>
        </form>

        <!-- Success message (hidden by default) -->
        <div id="form-success" class="hidden mt-6 p-5 rounded-xl bg-green-500/10 border border-green-500/30 text-center">
          <svg class="w-10 h-10 text-green-400 mx-auto mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <p class="text-green-400 font-semibold text-lg">Message sent!</p>
          <p class="text-gray-400 text-sm mt-1">We'll get back to you within 24 hours. Want to talk sooner?</p>
          <a href="https://calendly.com/geekbytessolutions" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-3 text-brand-accent text-sm font-semibold hover:underline">
            Book a call on Calendly →
          </a>
        </div>

        <!-- Error message (hidden by default) -->
        <div id="form-error" class="hidden mt-6 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-center">
          <p class="text-red-400 font-semibold">Something went wrong.</p>
          <p class="text-gray-400 text-sm mt-1">Please email us directly at <a href="mailto:info@geekbytestech.com" class="text-brand-accent hover:underline">info@geekbytestech.com</a></p>
        </div>
      </div>
    </div>

    <!-- Calendly booking -->
    <div class="mt-16 pt-12 border-t border-white/10">
      <div class="text-center mb-8">
        <p class="section-label mb-3">PREFER TO TALK?</p>
        <h3 class="text-2xl font-bold text-brand-white">Book a Free 30-Minute Call</h3>
        <p class="text-gray-400 text-sm mt-2">Pick a time that works for you — no pressure, no commitment.</p>
      </div>
      <!-- Calendly inline embed -->
      <div
        class="calendly-inline-widget rounded-2xl overflow-hidden border border-white/10"
        data-url="https://calendly.com/geekbytessolutions?hide_gdpr_banner=1&background_color=0a0a0a&text_color=ffffff&primary_color=3b82f6"
        style="min-width:320px;height:700px;"
      ></div>
      <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } else {
        throw new Error('failed');
      }
    } catch {
      errorEl?.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message ✈';
    }
  });
</script>
