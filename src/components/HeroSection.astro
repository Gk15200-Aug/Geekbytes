---
// Hero Section — full viewport height with animated background, heading, CTAs, and stats bar
---

<section id="hero" aria-label="Hero" class="relative min-h-screen flex items-center justify-center bg-brand-black pt-16 overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0 z-0">
    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 hero-grid"></div>

    <!-- Horizontal scanning line moving top to bottom -->
    <div class="scan-line"></div>

    <!-- Top blue glow -->
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-brand-accent/15 rounded-full blur-[150px] animate-pulse-slow"></div>

    <!-- Corner glow accents -->
    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-brand-accent/8 rounded-full blur-[120px] animate-float-2"></div>
    <div class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-blue-600/8 rounded-full blur-[100px] animate-float-3"></div>

    <!-- Vertical falling lines (CSS-only) -->
    <div class="falling-line" style="left: 10%; animation-delay: 0s; animation-duration: 7s;"></div>
    <div class="falling-line" style="left: 25%; animation-delay: 2s; animation-duration: 9s;"></div>
    <div class="falling-line" style="left: 40%; animation-delay: 4s; animation-duration: 6s;"></div>
    <div class="falling-line" style="left: 55%; animation-delay: 1s; animation-duration: 8s;"></div>
    <div class="falling-line" style="left: 70%; animation-delay: 3s; animation-duration: 7.5s;"></div>
    <div class="falling-line" style="left: 85%; animation-delay: 5s; animation-duration: 6.5s;"></div>
    <div class="falling-line" style="left: 95%; animation-delay: 2.5s; animation-duration: 8.5s;"></div>
    <div class="falling-line" style="left: 5%; animation-delay: 6s; animation-duration: 9.5s;"></div>
  </div>

  <div class="relative z-10 max-w-container mx-auto px-4 py-20 flex flex-col items-center text-center">
    <!-- Badge with glassy sliding shine -->
    <div class="badge-shine relative inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/15 bg-white/5 backdrop-blur-md mb-8 overflow-hidden">
      <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
      <span data-i18n="hero.badge" class="text-sm text-brand-white/90 font-medium">Web · AI · Mobile · Cloud — Starting at $12/hr</span>
    </div>

    <!-- Main Heading -->
    <h1 class="hero-heading text-5xl md:text-6xl lg:text-7xl xl:text-[5.5rem] font-extrabold leading-[1.1] max-w-5xl tracking-tight">
      <span data-i18n="hero.heading1" class="text-brand-white">We Build Websites, Apps</span>
      <br />
      <span data-i18n="hero.heading2" class="hero-gradient-text">&amp; AI That Grow Your Business</span><span class="typing-cursor">|</span>
    </h1>

    <!-- UVP Subtext -->
    <p data-i18n="hero.subtext" class="mt-6 text-lg md:text-xl text-brand-white/70 max-w-2xl leading-relaxed font-light">
      GeekBytes helps growing businesses in the US, UK &amp; Australia get agency-quality development —
      <span class="text-brand-accent font-semibold">at a fraction of the cost</span>.
      Fast delivery. No hand-offs. Real results.
    </p>

    <!-- Industry specialization tags -->
    <div class="flex flex-wrap justify-center gap-2 mt-5">
      {["Healthcare", "Hospitality", "eCommerce", "SaaS", "Automotive"].map((ind) => (
        <span class="text-xs px-3 py-1 rounded-full border border-white/15 text-gray-400 bg-white/3">
          {ind}
        </span>
      ))}
    </div>

    <!-- CTA Buttons -->
    <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
      <a
        href="https://calendly.com/geekbytessolutions"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="hero.cta.primary"
        class="btn-primary text-base px-8 py-3.5 min-h-[44px] inline-flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black shadow-lg shadow-brand-accent/20"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Book a Free Call
      </a>
      <a
        href="/case-studies"
        data-i18n="hero.cta.secondary"
        class="btn-outline text-base px-8 py-3.5 min-h-[44px] inline-flex items-center focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-black"
      >
        See Case Studies &rarr;
      </a>
    </div>

    <!-- Trust strip -->
    <div class="mt-10 flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-sm text-brand-white/40">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <span class="text-brand-white/60 font-medium">4.8 on Google</span>
      </span>
      <span class="hidden sm:block text-white/20">·</span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Responds within 24 hrs</span>
      </span>
      <span class="hidden sm:block text-white/20">·</span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>Projects kick off within 1 week</span>
      </span>
      <span class="hidden sm:block text-white/20">·</span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>
        <span>Serving US · UK · AU · Middle East</span>
      </span>
    </div>

    <!-- Stats Bar -->
    <div class="mt-10 w-full max-w-3xl border-t border-white/5 pt-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-0 md:divide-x md:divide-white/10">
        <div class="flex flex-col items-center px-4 py-3">
          <span class="text-3xl md:text-4xl font-bold text-brand-accent">50+</span>
          <span data-i18n="hero.stats.projects" class="mt-1 text-sm text-brand-white/40 font-light">Projects Delivered</span>
        </div>
        <div class="flex flex-col items-center px-4 py-3">
          <span class="text-3xl md:text-4xl font-bold text-brand-accent">30+</span>
          <span data-i18n="hero.stats.clients" class="mt-1 text-sm text-brand-white/40 font-light">Happy Clients</span>
        </div>
        <div class="flex flex-col items-center px-4 py-3">
          <span class="text-3xl md:text-4xl font-bold text-brand-accent">$12</span>
          <span class="mt-1 text-sm text-brand-white/40 font-light">Per Hour Rate</span>
        </div>
        <div class="flex flex-col items-center px-4 py-3">
          <span class="text-3xl md:text-4xl font-bold text-brand-accent">99%</span>
          <span data-i18n="hero.stats.satisfaction" class="mt-1 text-sm text-brand-white/40 font-light">Client Satisfaction</span>
        </div>
      </div>
    </div>
  </div>
</section>
