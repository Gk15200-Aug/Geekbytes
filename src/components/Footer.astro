---
import Logo from './icons/Logo.astro';
---

<div class="bg-brand-black border-t border-white/5">
  <div class="max-w-container mx-auto px-4 py-12">
    <!-- 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- LEFT: Brand -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <Logo />
          <span class="text-brand-white font-bold text-xl">GeekBytes</span>
        </div>
        <p data-i18n="footer.tagline" class="text-gray-400 text-sm leading-relaxed">
          Empowering businesses with modern, scalable, and secure technology solutions. Your trusted IT partner.
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-3 mt-5">
          <a href="https://linkedin.com/company/geekbytes-solutions/" target="_blank" rel="noopener noreferrer" aria-label="GeekBytes on LinkedIn" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-brand-accent hover:border-brand-accent/40 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.instagram.com/_geekbytes" target="_blank" rel="noopener noreferrer" aria-label="GeekBytes on Instagram" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-brand-accent hover:border-brand-accent/40 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="mailto:geekbytessolutions@gmail.com" aria-label="Email GeekBytes" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-brand-accent hover:border-brand-accent/40 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </a>
        </div>
      </div>

      <!-- CENTER: Quick Links -->
      <div>
        <p data-i18n="footer.quicklinks" class="text-brand-white font-bold mb-4">Quick Links</p>
        <ul class="space-y-2">
          <li><a href="/#hero" data-i18n="footer.home" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Home</a></li>
          <li><a href="/#company" data-i18n="footer.about" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">About Us</a></li>
          <li><a href="/#services" data-i18n="footer.services" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Services</a></li>
          <li><a href="/services" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">All Services</a></li>
          <li><a href="/blog" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Blog</a></li>
          <li><a href="/about" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">About Us</a></li>
          <li><a href="/#projects" data-i18n="footer.projects" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Projects</a></li>
          <li><a href="/#contact" data-i18n="footer.contact" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- RIGHT: Legal -->
      <div>
        <p data-i18n="footer.legal" class="text-brand-white font-bold mb-4">Legal</p>
        <ul class="space-y-2">
          <li><a href="/privacy-policy" data-i18n="footer.privacy" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-of-service" data-i18n="footer.terms" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Terms of Service</a></li>
          <li><a href="/refund-policy" data-i18n="footer.refund" class="text-gray-400 text-sm hover:text-brand-accent transition-colors">Refund Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 mt-8 pt-6 flex justify-center">
      <p data-i18n="footer.copyright" class="text-gray-400 text-sm">&copy; 2026 GeekBytes. All rights reserved.</p>
    </div>
  </div>
</div>
