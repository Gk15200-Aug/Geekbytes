---
import { testimonials } from '../data/testimonials';
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="py-20 lg:py-24">
  <div class="max-w-container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <p class="section-label mb-4">CLIENT SUCCESS</p>
      <h2 id="testimonials-heading" class="section-heading">Why Work With Us</h2>
    </div>

    <!-- Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((testimonial) => (
        <div class="animate-on-scroll opacity-0 translate-y-4 transition-all duration-700 bg-white/5 rounded-2xl border border-white/10 p-6">
          <!-- Avatar + Name + Role -->
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-accent to-blue-700 flex items-center justify-center text-brand-white font-bold text-sm shrink-0">
              {testimonial.name.split(' ').map(n => n[0]).join('')}
            </div>
            <div>
              <p class="text-brand-white font-bold">{testimonial.name}</p>
              <p class="text-gray-400 text-sm">{testimonial.role}</p>
            </div>
          </div>

          <!-- Star Rating -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-5 h-5" viewBox="0 0 20 20" fill="#FBBF24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
            <span class="sr-only">{testimonial.rating} out of 5 stars</span>
          </div>

          <!-- Quote -->
          <p class="text-brand-white/60 italic">"{testimonial.quote}"</p>
        </div>
      ))}
    </div>
  </div>
</section>
