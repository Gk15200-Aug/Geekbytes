---
const googleProfileUrl = "https://share.google/uzkKhnpFlFwRVnL1L";

const reviews = [
  {
    name: "James R.",
    title: "Owner, Automotive Services · South Australia",
    stars: 5,
    date: "2025",
    text: "GeekBytes transformed our online presence completely. We went from zero digital leads to #1 on Google for our target keywords within weeks of launch. The site is fast, clean, and genuinely brings in new business every day.",
  },
  {
    name: "Sarah M.",
    title: "Founder, eCommerce Brand · United States",
    stars: 5,
    date: "2025",
    text: "They understood exactly what we needed and delivered ahead of schedule. The mobile-first checkout they built for us cut cart abandonment significantly. Excellent communication throughout — felt like a local team despite being offshore.",
  },
  {
    name: "Dr. T. Menon",
    title: "Medical Clinic Director · Canada",
    stars: 5,
    date: "2024",
    text: "Our new website has been generating consistent online appointment bookings since launch. The team was professional, responsive, and genuinely cared about the outcome. We've already referred three other clinics.",
  },
  {
    name: "Mark H.",
    title: "SaaS Founder · United Kingdom",
    stars: 5,
    date: "2025",
    text: "The GeekBytes team delivered a complex platform integration in half the time a UK agency quoted. The quality of code is clean, well-documented, and the whole experience was straightforward. We'll use GeekBytes for all future dev work.",
  },
];
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="py-20 lg:py-24">
  <div class="max-w-container mx-auto px-4">

    <!-- Section Header -->
    <div class="text-center mb-14">
      <p class="section-label mb-4">CLIENT REVIEWS</p>
      <h2 id="testimonials-heading" class="section-heading">What Clients Say</h2>
      <!-- Google rating badge -->
      <div class="inline-flex items-center gap-2.5 mt-5 px-4 py-2 rounded-full bg-white/5 border border-white/10">
        <div class="flex gap-0.5">
          {[1,2,3,4,5].map(() => (
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="#FBBF24" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <span class="text-brand-white font-semibold text-sm">4.8</span>
        <span class="text-gray-400 text-xs">on Google</span>
        <span class="text-white/20 text-xs">·</span>
        <a href={googleProfileUrl} target="_blank" rel="noopener noreferrer" class="text-brand-accent text-xs font-medium hover:underline underline-offset-2">
          See all reviews →
        </a>
      </div>
    </div>

    <!-- Review grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
      {reviews.map((r) => (
        <div class="card-hover bg-white/[0.04] border border-white/10 rounded-2xl p-7 flex flex-col gap-4">
          <!-- Stars -->
          <div class="flex gap-1">
            {Array.from({ length: r.stars }).map(() => (
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="#FBBF24" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <!-- Quote -->
          <p class="text-brand-white/70 text-sm leading-relaxed flex-1">"{r.text}"</p>
          <!-- Attribution -->
          <div class="flex items-center justify-between pt-3 border-t border-white/8">
            <div>
              <p class="text-brand-white font-semibold text-sm">{r.name}</p>
              <p class="text-gray-500 text-xs mt-0.5">{r.title}</p>
            </div>
            <span class="text-xs text-gray-600">{r.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Leave a review nudge -->
    <p class="text-center text-gray-500 text-xs">
      A past client?&nbsp;
      <a
        href={googleProfileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-accent hover:underline"
      >
        Leave us a review on Google
      </a>
      — it takes 30 seconds and helps other businesses find us.
    </p>

  </div>
</section>
