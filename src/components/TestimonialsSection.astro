---
const googleProfileUrl = "https://share.google/uzkKhnpFlFwRVnL1L";
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="py-20 lg:py-24">
  <div class="max-w-container mx-auto px-4">

    <!-- Section Header -->
    <div class="text-center mb-12">
      <p class="section-label mb-4">CLIENT REVIEWS</p>
      <h2 id="testimonials-heading" class="section-heading">What Clients Say</h2>
      <p class="text-gray-400 mt-4 max-w-xl mx-auto text-sm">
        Real reviews from real clients — verified on Google Business.
      </p>
    </div>

    <!-- Google Reviews Card -->
    <div class="max-w-2xl mx-auto">
      <a
        href={googleProfileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group block bg-white/5 border border-white/10 hover:border-brand-accent/40 rounded-2xl p-8 transition-all duration-300 hover:bg-white/8 text-center"
        aria-label="View GeekBytes reviews on Google"
      >
        <!-- Google Logo + Stars -->
        <div class="flex flex-col items-center gap-4 mb-6">
          <svg class="w-28" viewBox="0 0 272 92" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M115.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18C71.25 34.32 81.24 25 93.5 25s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44S80.99 39.2 80.99 47.18c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z" fill="#EA4335"/>
            <path d="M163.75 47.18c0 12.77-9.99 22.18-22.25 22.18s-22.25-9.41-22.25-22.18c0-12.85 9.99-22.18 22.25-22.18s22.25 9.32 22.25 22.18zm-9.74 0c0-7.98-5.79-13.44-12.51-13.44s-12.51 5.46-12.51 13.44c0 7.9 5.79 13.44 12.51 13.44s12.51-5.55 12.51-13.44z" fill="#FBBC05"/>
            <path d="M209.75 26.34v39.82c0 16.38-9.66 23.07-21.08 23.07-10.75 0-17.22-7.19-19.66-13.07l8.48-3.53c1.51 3.61 5.21 7.87 11.17 7.87 7.31 0 11.84-4.51 11.84-13v-3.19h-.34c-2.18 2.69-6.38 5.04-11.68 5.04-11.09 0-21.25-9.66-21.25-22.09 0-12.52 10.16-22.26 21.25-22.26 5.29 0 9.49 2.35 11.68 4.96h.34v-3.61h9.25zm-8.56 20.92c0-7.81-5.21-13.52-11.84-13.52-6.72 0-12.35 5.71-12.35 13.52 0 7.73 5.63 13.36 12.35 13.36 6.63 0 11.84-5.63 11.84-13.36z" fill="#4285F4"/>
            <path d="M225 3v65h-9.5V3h9.5z" fill="#34A853"/>
            <path d="M262.02 54.48l7.56 5.04c-2.44 3.61-8.32 9.83-18.48 9.83-12.6 0-22.01-9.74-22.01-22.18 0-13.19 9.49-22.18 20.92-22.18 11.51 0 17.14 9.16 18.98 14.11l1.01 2.52-29.65 12.28c2.27 4.45 5.8 6.72 10.75 6.72 4.96 0 8.4-2.44 10.92-6.14zm-23.27-7.98l19.82-8.23c-1.09-2.77-4.37-4.7-8.23-4.7-4.95 0-11.84 4.37-11.59 12.93z" fill="#EA4335"/>
            <path d="M35.29 41.41V32H67c.31 1.64.47 3.58.47 5.68 0 7.06-1.93 15.79-8.15 22.01-6.05 6.3-13.78 9.66-24.02 9.66C16.32 69.35.36 53.89.36 34.91.36 15.93 16.32.47 35.3.47c10.5 0 17.98 4.12 23.6 9.49l-6.64 6.64c-4.03-3.78-9.49-6.72-16.97-6.72-13.86 0-24.7 11.17-24.7 25.03 0 13.86 10.84 25.03 24.7 25.03 8.99 0 14.11-3.61 17.39-6.89 2.66-2.66 4.41-6.46 5.1-11.65l-22.49.01z" fill="#4285F4"/>
          </svg>

          <!-- Star rating -->
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              {[1,2,3,4,5].map(() => (
                <svg class="w-6 h-6" viewBox="0 0 20 20" fill="#FBBF24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class="text-brand-white font-bold text-lg">4.8</span>
            <span class="text-gray-400 text-sm">on Google</span>
          </div>
        </div>

        <p class="text-gray-300 text-sm mb-6 leading-relaxed">
          See what our clients are saying about their experience working with GeekBytes — web development, AI chatbots, mobile apps, and more.
        </p>

        <!-- CTA Button -->
        <span class="inline-flex items-center gap-2 bg-brand-accent/10 border border-brand-accent/30 text-brand-accent text-sm font-semibold px-5 py-2.5 rounded-full group-hover:bg-brand-accent/20 transition-colors">
          Read Our Google Reviews
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </span>
      </a>

      <!-- Leave a review nudge -->
      <p class="text-center text-gray-500 text-xs mt-5">
        A past client?&nbsp;
        <a
          href={googleProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-accent hover:underline"
        >
          Leave us a review on Google
        </a>
        — it takes 30 seconds and helps other businesses find us.
      </p>
    </div>

  </div>
</section>
