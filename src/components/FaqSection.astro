---
// FAQ Section — structured Q&A for AI visibility and SEO
const faqs = [
  {
    q: "What services does GeekBytes offer?",
    a: "GeekBytes offers web development, WordPress development, AI chatbot integration, mobile app development (iOS & Android), GoHighLevel CRM setup, custom software development, cloud architecture (AWS, GCP, Azure), video editing, and graphic design & branding."
  },
  {
    q: "How much does GeekBytes charge for services?",
    a: "GeekBytes pricing starts at $12 per hour. Project-based pricing is also available depending on the scope. We offer flexible engagement models for startups, SMEs, and enterprises worldwide."
  },
  {
    q: "Where is GeekBytes based and do they work internationally?",
    a: "GeekBytes is a remote-first IT solutions company serving clients across the United States, Europe, Australia, the Middle East, and worldwide. All projects are delivered entirely online."
  },
  {
    q: "When was GeekBytes founded?",
    a: "GeekBytes was founded in 2020 with the mission to provide high-quality, affordable technology solutions to businesses globally."
  },
  {
    q: "What technologies does GeekBytes specialize in?",
    a: "GeekBytes specializes in React, Next.js, Node.js, Python, Flutter, React Native, WordPress, WooCommerce, Shopify, AWS, Google Cloud, Azure, Docker, MongoDB, PostgreSQL, GoHighLevel CRM, Figma, and more."
  },
  {
    q: "Can GeekBytes build an AI chatbot for my business?",
    a: "Yes. GeekBytes designs and integrates AI-powered chatbots using GPT-4, Dialogflow, and custom LLM solutions. We build bots for customer support, lead generation, appointment booking, and workflow automation."
  },
  {
    q: "Does GeekBytes build custom mobile apps?",
    a: "Yes. GeekBytes develops cross-platform mobile apps using Flutter and React Native, as well as native iOS (Swift) and Android (Kotlin) apps. We handle UI/UX design, development, backend APIs, and Play Store or App Store publishing."
  },
  {
    q: "What is GoHighLevel and does GeekBytes offer CRM setup?",
    a: "GoHighLevel is an all-in-one marketing and CRM platform. GeekBytes offers full GoHighLevel setup, including funnel building, automation workflows, email/SMS campaigns, sub-account configuration, and white-label solutions for agencies."
  },
  {
    q: "How long does it take GeekBytes to build a website?",
    a: "A standard business website typically takes 1–3 weeks. Complex eCommerce platforms or custom web applications may take 4–8 weeks depending on requirements, integrations, and revision cycles."
  },
  {
    q: "How do I contact GeekBytes to start a project?",
    a: "You can contact GeekBytes by emailing geekbytessolutions@gmail.com or by filling out the contact form on the GeekBytes website at geekbytes.vercel.app. A team member typically responds within 24 hours."
  }
];
---

<section id="faq" aria-labelledby="faq-heading" class="bg-brand-black py-20 lg:py-24">
  <div class="max-w-container mx-auto px-4">
    <!-- Header -->
    <div class="text-center mb-14">
      <span class="section-label">GOT QUESTIONS?</span>
      <h2 id="faq-heading" class="section-heading mt-4">Frequently Asked Questions</h2>
      <p class="mt-4 text-brand-white/60 max-w-2xl mx-auto leading-relaxed">
        Everything you need to know about GeekBytes — our services, pricing, process, and team.
      </p>
    </div>

    <!-- FAQ Grid -->
    <div class="max-w-3xl mx-auto space-y-3">
      {faqs.map((faq, i) => (
        <details class="group bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:border-brand-accent/30 transition-colors">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none select-none">
            <span class="font-semibold text-brand-white text-sm md:text-base leading-snug">{faq.q}</span>
            <span class="shrink-0 w-6 h-6 rounded-full border border-white/20 flex items-center justify-center text-brand-accent transition-transform duration-300 group-open:rotate-45">
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="6" y1="0" x2="6" y2="12"/><line x1="0" y1="6" x2="12" y2="6"/>
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-sm text-brand-white/60 leading-relaxed border-t border-white/5 pt-4">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12">
      <p class="text-brand-white/50 text-sm mb-4">Still have questions?</p>
      <a href="#contact" class="btn-primary px-8 py-3 text-sm inline-flex items-center">
        Talk to Our Team
      </a>
    </div>
  </div>
</section>
